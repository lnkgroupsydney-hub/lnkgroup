import test from 'node:test'
import assert from 'node:assert/strict'
import {createHash,randomUUID} from 'node:crypto'
import {processCompanyRevisionOutbox,COMPANY_REVISION_EMAIL_RETRY_WINDOW_MS,type CompanyRevisionDeliveryClaim,type CompanyRevisionDeliveryDependencies} from './company-revision-delivery.ts'
function harness(kind:CompanyRevisionDeliveryClaim['kind']='revision_notice'){
 const now=Date.parse('2026-10-21T00:00:00Z'),pdfBase64=Buffer.from('%PDF-1.4\nSynthetic fixture').toString('base64'),revisionId=randomUUID();let busy=false
 const claim:CompanyRevisionDeliveryClaim={id:randomUUID(),requestId:randomUUID(),revisionId,kind,leaseToken:'',leaseExpiresAt:new Date(now+120000).toISOString(),emailFirstAttemptAt:null,emailIdempotencyKey:`company-revision:${revisionId}:${kind}:v1`,emailStatus:'pending',revisionSnapshotHash:'a'.repeat(64),acceptanceSignedContentHash:kind==='revision_notice'?null:'b'.repeat(64),frozenMail:{pdfBase64,pdfHash:createHash('sha256').update(Buffer.from(pdfBase64,'base64')).digest('hex'),payload:{from:'L&K Group <quotes@lnkgroupsydney.com.au>',reply_to:'lnkgroupsydney@gmail.com',to:['original@example.invalid'],subject:'Revised quote',text:'Synthetic receipt',html:'<p>Synthetic receipt</p>',attachments:[{filename:`REQUEST-TEST-${kind}-v1.pdf`,content:pdfBase64}]}}}
 const calls:string[]=[],bodies:string[]=[],keys:string[]=[];const deps:CompanyRevisionDeliveryDependencies={now:()=>now,config:{enabled:true,apiKey:'fake-only'},request:async(_url,init)=>{bodies.push(String(init?.body));keys.push(new Headers(init?.headers).get('Idempotency-Key')!);return Response.json({id:'provider-1'})},command:async<T>(name,args)=>{calls.push(name);if(name==='worker_claim'){if(busy||claim.emailStatus==='provider_accepted')return null as T;busy=true;claim.leaseToken=String(args.leaseToken);claim.leaseExpiresAt??=new Date(now+120000).toISOString()}else{assert.equal(args.leaseToken,claim.leaseToken);assert.equal(args.id,claim.id);if(name==='worker_email_attempt'){claim.emailFirstAttemptAt??=new Date(now).toISOString();claim.emailStatus='sending'}if(name==='worker_email_accepted'){claim.emailStatus='provider_accepted';claim.leaseToken=null;claim.leaseExpiresAt=null;busy=false}if(name==='worker_error'){claim.emailStatus=String(args.outcome);claim.leaseToken=null;claim.leaseExpiresAt=null;busy=false}}return structuredClone(claim) as T}}
 return {claim,deps,calls,bodies,keys,unlock:()=>{busy=false}}
}
test('publication and acceptance each send once; rerunning a completed worker sends nothing',async()=>{for(const kind of ['revision_notice','revision_acceptance_receipt'] as const){const h=harness(kind);assert.equal((await processCompanyRevisionOutbox(undefined,h.deps)).accepted,1);assert.equal((await processCompanyRevisionOutbox(undefined,h.deps)).claimed,0);assert.equal(h.bodies.length,1);assert.equal(h.keys[0],h.claim.emailIdempotencyKey);assert.deepEqual(h.calls,['worker_claim','worker_email_attempt','worker_email_accepted','worker_claim'])}})
test('lost provider response retries identical frozen payload with the same key inside the provider window',async()=>{const h=harness(),send=h.deps.request;let count=0;h.deps.request=async(input,init)=>{const response=await send(input,init);if(++count===1)throw Error('Synthetic lost response');return response};assert.equal((await processCompanyRevisionOutbox(undefined,h.deps)).retrying,1);assert.equal((await processCompanyRevisionOutbox(undefined,h.deps)).accepted,1);assert.equal(h.bodies[0],h.bodies[1]);assert.equal(h.keys[0],h.keys[1])})
test('expired uncertainty, stale lease, altered payload and storage failure never send',async()=>{const old=harness();old.claim.emailFirstAttemptAt=new Date(old.deps.now()-COMPANY_REVISION_EMAIL_RETRY_WINDOW_MS).toISOString();assert.equal((await processCompanyRevisionOutbox(undefined,old.deps)).reviewRequired,1);assert.equal(old.bodies.length,0);const short=harness();short.claim.leaseExpiresAt=new Date(short.deps.now()+1000).toISOString();assert.equal((await processCompanyRevisionOutbox(undefined,short.deps)).retrying,1);assert.equal(short.bodies.length,0);const changed=harness(),command=changed.deps.command;changed.deps.command=async<T>(name,args)=>{const result=await command<T>(name,args);if(name==='worker_email_attempt'){changed.claim.frozenMail.payload.to=['other@example.invalid'];return structuredClone(changed.claim) as T}return result};assert.equal((await processCompanyRevisionOutbox(undefined,changed.deps)).storageErrors,1);assert.equal(changed.bodies.length,0);const failed=harness();failed.deps.command=async()=>{throw Error('Synthetic DB unavailable')};assert.equal((await processCompanyRevisionOutbox(undefined,failed.deps)).storageErrors,1);assert.equal(failed.bodies.length,0)})
test('configuration, provider errors and disabled mode preserve durable state without unbounded retries',async()=>{const missing=harness();missing.deps.config.apiKey='';assert.equal((await processCompanyRevisionOutbox(undefined,missing.deps)).configurationMissing,true);assert.equal(missing.bodies.length,0);for(const [status,field]of [[429,'retrying'],[503,'retrying'],[409,'reviewRequired'],[401,'failed']] as const){const h=harness();h.deps.request=async()=>Response.json({name:'synthetic_error'},{status});assert.equal((await processCompanyRevisionOutbox(undefined,h.deps))[field],1)}const disabled=harness();disabled.deps.config.enabled=false;assert.equal((await processCompanyRevisionOutbox(undefined,disabled.deps)).disabled,true);assert.equal(disabled.calls.length,0)})

test('withdrawal detected after claim prevents any provider request',async()=>{const h=harness(),command=h.deps.command;h.deps.command=async<T>(name,args)=>{if(name==='worker_email_attempt')throw Error('revision_withdrawn');return command<T>(name,args)};const result=await processCompanyRevisionOutbox(undefined,h.deps);assert.equal(result.storageErrors,1);assert.equal(result.accepted,0);assert.equal(h.bodies.length,0)})
