import test from 'node:test'
import assert from 'node:assert/strict'
import {PDFDocument,PDFRawStream,decodePDFRawStream} from 'pdf-lib'
import {randomUUID} from 'node:crypto'
import {createCompanyRevisionMail,companyRevisionMailValid,type CompanyRevisionMailPrepared} from './company-revision-receipt.ts'
import {COMPANY_REVISION_ACK,calculateCompanyRevisionPricing,type CompanyRevision} from '../domain/company-revision.ts'
const sender={from:'L&K Group <quotes@lnkgroupsydney.com.au>',replyTo:'lnkgroupsydney@gmail.com'}
function prepared():CompanyRevisionMailPrepared{const payload={contact:{name:'Customer',email:'edited@example.invalid',phone:'0400 000 000',siteAddress:'1 Test Street',suburb:'Sydney',postcode:'2000',details:''},quantities:{doorCount:2,drawerCount:0,moderateRepair:false},extraItems:[{id:randomUUID(),description:'Extra work',amountCents:10000,reason:'Site repair'}],customerNote:'Please review.'},pricing=calculateCompanyRevisionPricing(payload);return {recipientEmail:'original@example.invalid',reference:'REQUEST-TEST-001',revision:{id:randomUUID(),requestId:randomUUID(),versionNo:1,revision:1,status:'draft',payload,pricing,totalCents:pricing.total,comparison:{original:{quantities:{doorCount:1,drawerCount:0,moderateRepair:false},lineItems:[],subtotalCents:145000,taxCents:0,totalCents:145000,pricingVersion:null},company:{quantities:payload.quantities,lineItems:pricing.lineItems,totalCents:pricing.total},deltaCents:10000,changes:[{field:'quantities.doorCount',before:1,after:2}]},snapshot:{immutable:'DB-prepared'},snapshotHash:'a'.repeat(64),baseSubmissionId:randomUUID(),baseSnapshotHash:'b'.repeat(64),baseSignedContentHash:'c'.repeat(64),basedOnRevisionId:null,publishedAt:null,acceptedAt:null,withdrawnAt:null,acceptance:null,emailStatus:null,receiptReady:false} as CompanyRevision}}
test('notice PDF and payload are deterministic, no-GST and sent only to original verified recipient',async()=>{const p=prepared(),a=await createCompanyRevisionMail('revision_notice',p,'https://example.invalid',sender),b=await createCompanyRevisionMail('revision_notice',p,'https://example.invalid',sender);assert.deepEqual(a,b);assert.ok(companyRevisionMailValid(a,p.recipientEmail));assert.deepEqual(a.payload.to,['original@example.invalid']);assert.match(String(a.payload.text),/AUD 1550.00/);assert.match(String(a.payload.text),/Opening this email or its link does not accept/);assert.match(String(a.payload.text),/https:\/\/example.invalid\/quote\/start\?service=cabinet-painting/);assert.doesNotMatch(String(a.payload.text),/token=|secret=|incl GST/);assert.equal(a.payload.reply_to,sender.replyTo);assert.ok(Buffer.from(a.pdfBase64,'base64').subarray(0,5).equals(Buffer.from('%PDF-')));assert.equal(companyRevisionMailValid({...a,pdfHash:'d'.repeat(64)}),false);assert.equal(companyRevisionMailValid({...a,payload:{...a.payload,to:['other@example.invalid']}},p.recipientEmail),false)})
test('acceptance requires the new exact acknowledgment, signature and DB signed hash',async()=>{const p=prepared();await assert.rejects(createCompanyRevisionMail('revision_acceptance_receipt',p,'https://example.invalid',sender));p.signature={name:'New Signer',method:'typed',strokes:[],acknowledged:true};p.signedContentHash='d'.repeat(64);p.acknowledgment=COMPANY_REVISION_ACK;const frozen=await createCompanyRevisionMail('revision_acceptance_receipt',p,'https://example.invalid',sender);assert.match(String(frozen.payload.text),/Your explicit acceptance and new signature have been recorded/);assert.match(String(frozen.payload.text),/not a contract, work authorisation or payment obligation/);await assert.rejects(createCompanyRevisionMail('revision_acceptance_receipt',{...p,acknowledgment:{...COMPANY_REVISION_ACK,text:'Contract'} as typeof COMPANY_REVISION_ACK},'https://example.invalid',sender));await assert.rejects(createCompanyRevisionMail('revision_notice',p,'https://example.invalid',{from:'attacker@example.invalid'}));await assert.rejects(createCompanyRevisionMail('revision_notice',{...p,revision:{...p.revision,totalCents:1}},'https://example.invalid',sender))})

test('bundled PDF font preserves accented names and curly apostrophes as searchable Unicode',async()=>{const p=prepared();p.revision.payload.contact.name='José O’Connor';const frozen=await createCompanyRevisionMail('revision_notice',p,'https://example.invalid',sender),pdf=await PDFDocument.load(Buffer.from(frozen.pdfBase64,'base64'));const streams=pdf.context.enumerateIndirectObjects().flatMap(([,object])=>object instanceof PDFRawStream?[Buffer.from(decodePDFRawStream(object).decode()).toString('utf8')]:[]).join('\n');assert.match(streams,/<00e9>/i);assert.match(streams,/<2019>/i);assert.doesNotMatch(streams,/U\+E9|U\+2019/)})

// Decode the embedded font's ToUnicode map and the actual page text operators.
async function pdfText(base64:string){const pdf=await PDFDocument.load(Buffer.from(base64,'base64'));const streams=pdf.context.enumerateIndirectObjects().flatMap(([,object])=>object instanceof PDFRawStream?[Buffer.from(decodePDFRawStream(object).decode()).toString('utf8')]:[]);const characters=new Map<string,string>();for(const stream of streams)for(const block of stream.matchAll(/beginbfchar([\s\S]*?)endbfchar/g))for(const match of block[1].matchAll(/<([\da-f]+)>\s*<([\da-f]+)>/gi))characters.set(match[1].toUpperCase(),Buffer.from(match[2],'hex').swap16().toString('utf16le'));return streams.flatMap(stream=>Array.from(stream.matchAll(/<([\da-f]+)>\s*Tj/gi),match=>match[1].match(/.{4}/g)!.map(code=>characters.get(code.toUpperCase())??'?').join(''))).join('\n')}
test('v2 original GST and readable changes appear in the actual PDF and both mail kinds',async()=>{const p=prepared(),r=p.revision;r.comparison.original={quantities:{doorCount:12,drawerCount:4,moderateRepair:false},lineItems:[{code:'doors',label:'Cabinet doors',quantity:12,unitAmount:15000,amount:180000},{code:'drawers',label:'Drawer fronts',quantity:4,unitAmount:10000,amount:40000}],subtotalCents:220000,taxCents:22000,totalCents:242000,pricingVersion:'cabinet-painting-v2'};r.comparison.deltaCents=r.totalCents-242000;r.comparison.changes=[{field:'quantities.doorCount',before:12,after:2},{field:'contact.phone',before:'0400 000 001',after:'0400 000 000'},{field:'extraItems',before:[],after:r.payload.extraItems},{field:'internal.unknown',before:{secret:'raw'},after:{secret:'changed'}}];p.signature={name:'Customer',method:'typed',strokes:[],acknowledged:true};p.signedContentHash='d'.repeat(64);p.acknowledgment=COMPANY_REVISION_ACK
 for(const kind of ['revision_notice','revision_acceptance_receipt'] as const){const frozen=await createCompanyRevisionMail(kind,p,'https://example.invalid',sender);for(const text of [String(frozen.payload.text),await pdfText(frozen.pdfBase64)]){assert.match(text,/Original signed quote subtotal: AUD 2200.00/);assert.match(text,/Original GST \(as signed\): AUD 220.00/);assert.match(text,/Original signed quote total: AUD 2420.00/);assert.match(text,/Revised quote GST: AUD 0.00. No GST is charged on the revised quote/);assert.match(text,/Cabinet doors: 12 -> 2/);assert.match(text,/Phone: 0400 000 001 -> 0400 000 000/);assert.match(text,/Additional item: Extra work \(AUD 100.00\). Reason: Site repair/);assert.doesNotMatch(text,/contact\.phone|extraItems|doorCount|internal\.unknown|"secret"|\{"|GST: 0\. No GST is charged\./)}}
})
test('prepared receipts reject inconsistent original amount evidence before freezing',async()=>{for(const original of [{subtotalCents:220000,taxCents:22000,totalCents:242001},{subtotalCents:-1,taxCents:1,totalCents:0},{subtotalCents:0,taxCents:0,totalCents:Number.MAX_SAFE_INTEGER+1}]){const p=prepared();Object.assign(p.revision.comparison.original,original);p.revision.comparison.deltaCents=p.revision.totalCents-original.totalCents;await assert.rejects(createCompanyRevisionMail('revision_notice',p,'https://example.invalid',sender))}})
