import test from 'node:test'
import assert from 'node:assert/strict'
import { WorkError } from '../enquiries/management.ts'
import { randomUUID } from 'node:crypto'
import { validateCompanyRevisionPayload, calculateCompanyRevisionPricing, compareCompanyRevision, companyRevisionAcceptInput, COMPANY_REVISION_ACK_VERSION, MAX_EXTRA_ITEM_CENTS_TECHNICAL } from './domain/company-revision.ts'
const contact={name:'Synthetic Customer',email:'customer@example.invalid',phone:'',siteAddress:'1 Synthetic Street',suburb:'Sydney',postcode:'2000',details:''}
const payload={contact,quantities:{doorCount:1,drawerCount:0,moderateRepair:true},extraItems:[{id:randomUUID(),description:'Additional preparation',amountCents:5000,reason:'Site inspection'}],customerNote:''}
test('company price applies painting minimum before once-only repair and extras, without GST',()=>{const value=validateCompanyRevisionPayload(payload),p=calculateCompanyRevisionPricing(value);assert.equal(p.total,175000);assert.equal(p.tax,0);assert.equal(p.lineItems.find(i=>i.code==='minimum_adjustment')!.amount,130000);assert.equal(calculateCompanyRevisionPricing({...value,quantities:{doorCount:10,drawerCount:1,moderateRepair:false}}).total,165000)})
test('extras accept positive integer cents only, reject duplicate IDs and technical overflow',()=>{for(const amountCents of [-1,0,.1,MAX_EXTRA_ITEM_CENTS_TECHNICAL+1])assert.throws(()=>validateCompanyRevisionPayload({...payload,extraItems:[{...payload.extraItems[0],amountCents}]}));assert.throws(()=>validateCompanyRevisionPayload({...payload,extraItems:[payload.extraItems[0],payload.extraItems[0]]}));assert.throws(()=>validateCompanyRevisionPayload({...payload,total:1}));assert.throws(()=>validateCompanyRevisionPayload({...payload,quantities:{...payload.quantities,doorCount:0}}))})
test('legacy contact is retained only when normalized value matches trusted source; publication strict gate rejects it',()=>{const source={contact:{...contact,email:'CUSTOMER@example.invalid',phone:'legacy wrong phone',consent:true},service:null};const legacy={...payload,contact:{...contact,email:' customer@EXAMPLE.invalid ',phone:'legacy wrong phone'}};assert.equal(validateCompanyRevisionPayload(legacy,source).contact.phone,'legacy wrong phone');assert.throws(()=>validateCompanyRevisionPayload({...legacy,contact:{...legacy.contact,phone:'changed wrong'}} ,source));assert.throws(()=>validateCompanyRevisionPayload(legacy))})
test('comparison always uses original signed quantities, original total and line items',()=>{const pricing={lineItems:[{code:'doors',label:'Doors',quantity:8,unitAmount:15000,amount:120000}],subtotal:145000,tax:0,total:145000};const result=compareCompanyRevision({pricing,payload:{contact,service:{doorCount:99,drawerCount:0}}},payload);assert.equal(result.original.quantities.doorCount,8);assert.equal(result.deltaCents,30000);assert.equal(result.company.totalCents,175000);assert.ok(result.changes.some(i=>i.field==='extraItems'))})
test('acceptance requires exact new acknowledgment, explicit consent and fresh valid signature',()=>{const input={revisionId:randomUUID(),expectedRevision:2,reviewProof:'proof',acknowledgmentVersion:COMPANY_REVISION_ACK_VERSION,acknowledged:true,signature:{name:'Synthetic Customer',method:'typed',strokes:[],acknowledged:true},idempotencyKey:randomUUID()};assert.equal(companyRevisionAcceptInput(input).signature.name,'Synthetic Customer');for(const change of [{acknowledged:false},{acknowledgmentVersion:'live-booking-request-ack-v2'},{signature:{...input.signature,acknowledged:false}},{pricing:{total:1}}])assert.throws(()=>companyRevisionAcceptInput({...input,...change}))})

test('extra descriptions and reasons are single-line with exact 422 fields while customer notes retain newlines',()=>{for(const key of ['description','reason'])for(const control of ['\n','\r','\t'])assert.throws(()=>validateCompanyRevisionPayload({...payload,extraItems:[{...payload.extraItems[0],[key]:`Before${control}after`}]}),(error:unknown)=>error instanceof WorkError&&!!error.fields?.[`payload.extraItems.0.${key}`]);assert.equal(validateCompanyRevisionPayload({...payload,customerNote:'First line\nSecond line'}).customerNote,'First line\nSecond line')})

test('signed original GST evidence is preserved without assuming a tax rate',()=>{
 const source={payload:{contact,service:{doorCount:12,drawerCount:4}},pricing:{pricingVersion:'cabinet-painting-v2',subtotal:220000,tax:22000,total:242000}}
 const original=compareCompanyRevision(source,payload).original
 assert.deepEqual(original,{quantities:{doorCount:12,drawerCount:4,moderateRepair:false},lineItems:[],subtotalCents:220000,taxCents:22000,totalCents:242000,pricingVersion:'cabinet-painting-v2'})
 for(const pricing of [{subtotal:220000,total:242000},{gst:22000,total:242000},{subtotal:220000,tax:null,gst:22000,total:242000}])assert.deepEqual(compareCompanyRevision({...source,pricing},payload).original,{...original,pricingVersion:null})
 const noGst=compareCompanyRevision({...source,pricing:{subtotal:145000,tax:0,total:145000,pricingVersion:'cabinet-painting-v3'}},payload).original
 assert.equal(noGst.taxCents,0);assert.equal(noGst.subtotalCents+noGst.taxCents,noGst.totalCents)
})
test('incomplete or inconsistent signed pricing is rejected rather than invented',()=>{
 const base={subtotal:220000,tax:22000,total:242000}
 for(const pricing of [{total:242000},{...base,total:1},{...base,tax:22000.5},{...base,subtotal:'220000'},{...base,tax:-1},{...base,gst:0},{...base,pricingVersion:1},{...base,total:Number.MAX_SAFE_INTEGER+1},{...base,subtotal:null,tax:null},{total:200,tax:201}])assert.throws(()=>compareCompanyRevision({payload:{contact,service:{}},pricing},payload))
})
