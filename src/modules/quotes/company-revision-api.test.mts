import test from 'node:test'
import assert from 'node:assert/strict'
import { randomUUID } from 'node:crypto'
import { createCompanyRevisionApi,type CompanyRevisionApiDependencies } from './infrastructure/company-revision-api.ts'
import { COMPANY_REVISION_ACK,calculateCompanyRevisionPricing,type CompanyRevision } from './domain/company-revision.ts'
import { WorkError } from '../enquiries/management.ts'
const base='http://127.0.0.1:3002',requestId=randomUUID(),revisionId=randomUUID(),actor={companyId:'lk-group',userId:randomUUID(),sessionId:randomUUID()},hash='a'.repeat(64),now=Date.now()
const owner={hash:'b'.repeat(64),expiresAt:new Date(now+3600000).toISOString(),customer:{companyId:'lk-group',sessionId:randomUUID(),authUserId:randomUUID(),email:'verified@example.invalid',requestId}}
const payload={contact:{name:'Customer',email:'changed@example.invalid',phone:'',siteAddress:'1 Street',suburb:'Sydney',postcode:'2000',details:''},quantities:{doorCount:1,drawerCount:0,moderateRepair:false},extraItems:[],customerNote:''},pricing=calculateCompanyRevisionPricing(payload)
const revision={id:revisionId,requestId,payload,pricing,totalCents:pricing.total,comparison:{original:{quantities:payload.quantities,lineItems:pricing.lineItems,subtotalCents:145000,taxCents:0,totalCents:145000,pricingVersion:null},company:{quantities:payload.quantities,lineItems:pricing.lineItems,totalCents:pricing.total},deltaCents:0,changes:[]},baseSubmissionId:randomUUID(),baseSnapshotHash:'b'.repeat(64),baseSignedContentHash:'c'.repeat(64),snapshot:{pricing},snapshotHash:hash,status:'published',versionNo:1,revision:2} as unknown as CompanyRevision
const state={requestId,revision:2,current:revision,effectiveAccepted:null,acknowledgment:COMPANY_REVISION_ACK}
function setup(overrides:Partial<CompanyRevisionApiDependencies>={}){const calls:{command:string;args:Record<string,unknown>}[]=[],queued:string[]=[],mails:string[]=[];let saved=false;const result={state,receipt:{entityType:'company_revision',entityId:requestId,childId:revisionId,revision:3,idempotencyKey:randomUUID(),action:'customer_accept',committedAt:new Date().toISOString()}};const deps:CompanyRevisionApiDependencies={store:{async command<T>(command,args){calls.push({command,args});if(command==='revision_source')return {contact:{...payload.contact,consent:true},service:null} as T;if(command==='customer_review')return {state,revision,snapshotHash:hash} as T;if(command==='revision_prepare_publish'||command==='customer_prepare_accept'){if(saved)return result as T;return {prepared:true,revision,snapshot:revision.snapshot,snapshotHash:hash,recipientEmail:owner.customer.email,reference:'RQ-SYNTHETIC',signedContentHash:'c'.repeat(64)} as T}if(command==='customer_accept'||command==='revision_publish'){saved=true;return result as T}return state as T}},now:()=>now,key:()=>hash,baseUrl:()=>base,enabled:()=>true,staff:async()=>actor,readOwner:async()=>owner,writeOwner:async()=>owner,mail:async(kind,p)=>{mails.push(p.recipientEmail);return {pdfBase64:'JVBERi0=',pdfHash:hash,payload:{kind}}},enqueue:id=>queued.push(id),...overrides};return {api:createCompanyRevisionApi(deps),calls,queued,mails}}
const req=(body?:unknown,headers:Record<string,string>={})=>new Request(base+'/api/test',{method:body===undefined?'GET':'POST',headers:{host:new URL(base).host,origin:base,'content-type':'application/json',...headers},...(body===undefined?{}:{body:JSON.stringify(body)})})
const mutation={revisionId,expectedRevision:2,idempotencyKey:randomUUID(),reason:'Verified site changes'}
test('GET is read-only and every response is private no-store',async()=>{const s=setup(),r=await s.api.customerState(req());assert.equal(r.status,200);assert.match(r.headers.get('cache-control')! ,/no-store/);assert.deepEqual(s.calls.map(c=>c.command),['customer_state']);assert.equal(s.mails.length,0)})
test('writes reject cross-origin, client money and nonverified owners before mutation',async()=>{const s=setup();assert.equal((await s.api.publish(req(mutation,{origin:'https://evil.invalid'}),requestId)).status,403);assert.equal((await s.api.publish(req({...mutation,totalCents:1}),requestId)).status,422);assert.equal(s.calls.length,0);const guest=setup({readOwner:async()=>({...owner,customer:undefined})});assert.equal((await guest.api.customerState(req())).status,403)})
test('save validates changed fields against trusted DB source and returns 422 fields',async()=>{const s=setup(),r=await s.api.save(req({expectedRevision:0,idempotencyKey:randomUUID(),reason:'Changed phone',payload:{...payload,contact:{...payload.contact,phone:'invalid new phone'}}}),requestId);assert.equal(r.status,422);assert.ok((await r.json()).fields['payload.contact.phone']);assert.equal(s.calls.some(c=>c.command==='revision_save'),false)})
test('publish freezes mail to verified original email and replay skips mail generation',async()=>{const s=setup();assert.equal((await s.api.publish(req(mutation),requestId)).status,200);assert.equal((await s.api.publish(req(mutation),requestId)).status,200);assert.deepEqual(s.mails,[owner.customer.email]);assert.deepEqual(s.queued,[requestId]);assert.equal(s.calls.at(-1)!.command,'revision_prepare_publish')})
test('review proof binds owner, request, revision hash and acknowledgment; accept is explicit and replay uses same proof',async()=>{const s=setup(),review=(await(await s.api.review(req({revisionId,snapshotHash:hash}))).json()).review;const input={revisionId,expectedRevision:2,reviewProof:review.reviewProof,acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true},idempotencyKey:randomUUID()};assert.equal((await s.api.accept(req(input))).status,200);assert.equal((await s.api.accept(req(input))).status,200);assert.equal(s.mails.length,1);assert.deepEqual(s.calls.at(-1)!.args.customerAccess,owner.customer);const other=setup({writeOwner:async()=>({...owner,hash:'d'.repeat(64)})});assert.equal((await other.api.accept(req(input))).status,403);assert.equal(other.calls.length,0);assert.equal((await s.api.accept(req({...input,reviewProof:review.reviewProof.slice(0,-8)+'AAAAAAAA'}))).status,409)})
test('expired proof rejects new acceptance while committed replay remains available',async()=>{let time=now;const s=setup({now:()=>time}),review=(await(await s.api.review(req({revisionId,snapshotHash:hash}))).json()).review;time+=900001;const input={revisionId,expectedRevision:2,reviewProof:review.reviewProof,acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true},idempotencyKey:randomUUID()};assert.equal((await s.api.accept(req(input))).status,409);assert.equal(s.mails.length,0)})
test('DB semantic conflicts preserve safe code and definite outcome',async()=>{const s=setup({store:{async command(){throw new WorkError(409,'revision_awaiting_customer','Customer acceptance required.')}}});const r=await s.api.withdraw(req(mutation),requestId);assert.equal(r.status,409);assert.equal((await r.json()).code,'revision_awaiting_customer')})

test('API prepare DTO connects to actual PDF/mail builder for publication and new acceptance',async()=>{const {createCompanyRevisionMail}=await import('./infrastructure/company-revision-receipt.ts'),sender={from:'L&K Group <quotes@lnkgroupsydney.com.au>',replyTo:'lnkgroupsydney@gmail.com'},mail:CompanyRevisionApiDependencies['mail']=(kind,p,url)=>createCompanyRevisionMail(kind,p,url,sender);const publish=setup({mail});assert.equal((await publish.api.publish(req(mutation),requestId)).status,200);const publishedMail=publish.calls.find(c=>c.command==='revision_publish')!.args.frozenMail as {pdfBase64:string;payload:{to:string[]}};assert.equal(Buffer.from(publishedMail.pdfBase64,'base64').subarray(0,5).toString(),'%PDF-');assert.deepEqual(publishedMail.payload.to,[owner.customer.email]);const accepted=setup({mail}),review=(await(await accepted.api.review(req({revisionId,snapshotHash:hash}))).json()).review;assert.equal((await accepted.api.accept(req({revisionId,expectedRevision:2,reviewProof:review.reviewProof,acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true},idempotencyKey:randomUUID()}))).status,200);assert.ok(accepted.calls.find(c=>c.command==='customer_accept')!.args.frozenMail)})
test('accept body supports valid maximum drawn signature while rejecting oversized and malformed bodies',async()=>{const s=setup(),review=(await(await s.api.review(req({revisionId,snapshotHash:hash}))).json()).review,points=Array.from({length:2000},(_,i)=>({x:i/1999,y:(i%50)/50})),input={revisionId,expectedRevision:2,reviewProof:review.reviewProof,acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'drawn',strokes:[points],acknowledged:true},idempotencyKey:randomUUID()};assert.ok(JSON.stringify(input).length>32768);assert.equal((await s.api.accept(req(input))).status,200);assert.equal((await s.api.accept(req({...input,reviewProof:'x'.repeat(190000)}))).status,413);assert.equal((await s.api.accept(req({...input,signature:{...input.signature,strokes:[points.concat({x:0,y:0})]}}))).status,400)})
