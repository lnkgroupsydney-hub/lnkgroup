import test from 'node:test'
import assert from 'node:assert/strict'
import { calculateEstimatePricing, pendingCompanyPricing, validateEstimatePricing, QUOTE_PRICING_VERSION } from './domain/pricing.ts'
import { PHOTO_ROLES, type PhotoAnalysis } from './domain/analysis.ts'
import type { ServiceDetails } from './domain/contracts.ts'
const service: ServiceDetails = {serviceId:'cabinet-painting',intent:'full-repainting',surfaces:['doors','drawers'],doorCount:8,drawerCount:3,material:'',colourPreference:''}
function analysis(): PhotoAnalysis { return {summary:'Visible coating wear.',outcome:'analysis_ready',photoQuality:[{photoId:'photo-1',usable:true,issues:[],retakeInstruction:null}],coverage:PHOTO_ROLES.map(role=>({role,covered:true,photoIds:['photo-1'],note:'Visible.'})),observedDamage:[],quantities:{doors:{observed:8,customer:8,needsConfirmation:false},drawers:{observed:3,customer:3,needsConfirmation:false}},proposedWork:[],unknowns:[],siteChecks:[]} }
const damage=(id:string,severity:'minor'|'moderate'|'severe'='moderate',kind:'chipping'|'swelling'|'joint_gap'|'other'='chipping')=>({id,kind,location:id,description:'Coating damage.',photoIds:['photo-1'],severity})
test('legacy unconfigured result remains money-free and independently validated',()=>{const value=pendingCompanyPricing();assert.equal(value.pricingVersion,'unconfigured');assert.equal(value.total,null);assert.deepEqual(validateEstimatePricing(value),value);assert.throws(()=>validateEstimatePricing({...value,total:165000}));})
test('minimum painting adjustment, integer cents and GST create exact line-item totals',()=>{const value=calculateEstimatePricing(analysis(),service);assert.equal(value.pricingVersion,QUOTE_PRICING_VERSION);assert.equal(value.status,'estimate_ready');assert.equal(value.subtotal,150000);assert.equal(value.tax,15000);assert.equal(value.total,165000);assert.equal(value.lineItems.some(item=>item.code==='minimum_adjustment'),false);assert.deepEqual(validateEstimatePricing(value),value);})
test('below-minimum input produces separate minimum adjustment; moderate repairs are charged once',()=>{const input=analysis();input.quantities.doors={observed:5,customer:5,needsConfirmation:false};input.quantities.drawers={observed:2,customer:2,needsConfirmation:false};input.observedDamage=[damage('edge-1'),damage('edge-2'),damage('edge-3','minor')];const value=calculateEstimatePricing(input,{...service,doorCount:5,drawerCount:2});assert.equal(value.lineItems.find(item=>item.code==='minimum_adjustment')!.amount,55000);assert.equal(value.lineItems.filter(item=>item.code==='moderate_repairs').length,1);assert.equal(value.subtotal,175000);assert.equal(value.tax,17500);assert.equal(value.total,192500);assert.deepEqual(validateEstimatePricing(value),value);})
test('above-minimum cabinet size scales by observed and customer-confirmed doors and drawers',()=>{const input=analysis();input.quantities.doors={observed:17,customer:17,needsConfirmation:false};input.quantities.drawers={observed:5,customer:5,needsConfirmation:false};const value=calculateEstimatePricing(input,{...service,intent:'colour-change',doorCount:17,drawerCount:5});assert.equal(value.subtotal,305000);assert.equal(value.tax,30500);assert.equal(value.total,335500);assert.equal(value.lineItems.some(item=>item.code==='minimum_adjustment'),false);assert.deepEqual(validateEstimatePricing(value),value);})
test('review conditions show only starting price and never partial total',()=>{const cases:Array<{input:PhotoAnalysis;service:ServiceDetails}>=[];for(const outcome of ['additional_photos_required','site_review_required'] as const) cases.push({input:{...analysis(),outcome},service});const unusable=analysis();unusable.photoQuality[0].usable=false;cases.push({input:unusable,service});const missing=analysis();missing.coverage=missing.coverage.filter(item=>item.role!=='side');cases.push({input:missing,service});const mismatch=analysis();mismatch.quantities.doors.observed=7;cases.push({input:mismatch,service});const nullCount=analysis();nullCount.quantities.drawers.observed=null;cases.push({input:nullCount,service});for(const severe of [damage('x','severe'),damage('x','minor','swelling'),damage('x','moderate','joint_gap'),damage('x','minor','other')])cases.push({input:{...analysis(),observedDamage:[severe]},service});for(const surfaces of [['frames'],['panels'],['unknown']])cases.push({input:analysis(),service:{...service,surfaces}});for(const intent of ['advice','partial-touch-ups'])cases.push({input:analysis(),service:{...service,intent}});for(const entry of cases){const value=calculateEstimatePricing(entry.input,entry.service);assert.equal(value.status,'review_required');assert.equal(value.minimumSubtotal,150000);assert.equal(value.total,null);assert.equal(value.tax,null);assert.equal(value.subtotal,null);assert.deepEqual(value.lineItems,[]);assert.ok(value.reviewReasons.length);assert.deepEqual(validateEstimatePricing(value),value);}})
test('pricing validator rejects missing GST, forged totals, rates, repeated repair lines and unsupported version',()=>{const value=calculateEstimatePricing({...analysis(),observedDamage:[damage('edge')]},service);const noTax:Partial<typeof value>={...value};delete noTax.tax;const bad=[noTax,{...value,total:1},{...value,tax:0},{...value,pricingVersion:'invented'},{...value,gstRateBps:0},{...value,amountUnit:'dollars'},{...value,lineItems:[...value.lineItems,value.lineItems.at(-1)!]},{...value,lineItems:value.lineItems.map(item=>({...item,amount:item.amount+1}))},{...value,status:'review_required'},{...value,extraAmount:123}];for(const entry of bad)assert.throws(()=>validateEstimatePricing(entry));})

test('unselected drawer painting and repair-only scope never receive a whole-cabinet price',()=>{
 for(const selected of [{...service,surfaces:['doors']},{...service,surfaces:['repairs'],doorCount:12,drawerCount:4}]) {
  const input=analysis();input.quantities.doors={observed:selected.doorCount,customer:selected.doorCount,needsConfirmation:false};input.quantities.drawers={observed:selected.drawerCount,customer:selected.drawerCount,needsConfirmation:false};
  const value=calculateEstimatePricing(input,selected);assert.equal(value.status,'review_required');assert.deepEqual(value.lineItems,[]);assert.equal(value.total,null);assert.ok(value.reviewReasons.some(reason=>reason.includes('scope')));assert.deepEqual(validateEstimatePricing(value),value);
 }
});
