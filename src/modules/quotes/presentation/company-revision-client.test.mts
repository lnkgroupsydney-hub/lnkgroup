import test from 'node:test'
import assert from 'node:assert/strict'
import { randomUUID } from 'node:crypto'
import { CurrentWorkClient,companyRevisionActions,parseCompanyRevisionState } from './company-revision-client.ts'
import { createCustomerCompanyRevisionClient } from './customer-company-revision-client.ts'
import { COMPANY_REVISION_ACK, calculateCompanyRevisionPricing, compareCompanyRevision } from '../domain/company-revision.ts'
const id=randomUUID(),revisionId=randomUUID(),key=randomUUID(),state={requestId:id,revision:0,current:null,effectiveAccepted:null,acknowledgment:COMPANY_REVISION_ACK}
const receipt={idempotencyKey:key,entityType:'company_revision',entityId:id,childId:revisionId,action:'revision_publish',revision:1,committedAt:new Date().toISOString()}
test('admin company client recovers response loss using same key and verified scoped receipt',async()=>{const bodies:string[]=[];let lost=true;const client=new CurrentWorkClient(parseCompanyRevisionState,async(_url,init)=>{bodies.push(String(init?.body));if(lost){lost=false;throw new Error('Lost after commit')}return Response.json({receipt})},()=>key),actions=companyRevisionActions(client,id);assert.equal((await actions.publish({revisionId,expectedRevision:0,reason:'Inspection'})).phase,'unknown');assert.equal((await actions.retry()).phase,'saved');assert.equal(bodies[0],bodies[1]);assert.equal(client.pendingRequest(),null)})
test('409 preserves input and 401/403 erase all private data, inputs and uncertain requests',async()=>{let status=200;const client=new CurrentWorkClient(parseCompanyRevisionState,async()=>status===200?Response.json(state):Response.json({error:'Changed',code:'revision_conflict',outcome:'not_applied',currentRevision:4},{status}),()=>key);await client.read('/read');status=409;const input={revisionId,expectedRevision:0,reason:'Retain input'};assert.equal((await companyRevisionActions(client,id).publish(input)).phase,'conflict');assert.deepEqual(client.snapshot().input,input);status=403;await client.read('/read');assert.equal(client.snapshot().phase,'access_lost');assert.equal(client.snapshot().data,null);assert.equal(client.snapshot().input,null);assert.equal(client.pendingRequest(),null)})
test('customer request always carries selected request header and rejects cross-request receipt',async()=>{const seen:string[]=[],customer=createCustomerCompanyRevisionClient(id,async(_url,init)=>{seen.push(new Headers(init?.headers).get('x-lk-quote-request-id')!);return init?.method?Response.json({receipt:{...receipt,entityId:randomUUID()}}):Response.json(state)},()=>key);await customer.detail();const accepted=await customer.accept({revisionId,expectedRevision:0,reviewProof:'proof',acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true}});assert.equal(accepted.phase,'unknown');assert.ok(seen.every(value=>value===id));assert.equal(customer.client.pendingRequest()!.body.idempotencyKey,key)})
test('stale read is discarded after clear, and customer receipt lookup keeps original pending key',async()=>{let complete:(value:Response)=>void=()=>{};const client=new CurrentWorkClient(parseCompanyRevisionState,()=>new Promise(resolve=>{complete=resolve}));const pending=client.read('/read');client.clear();complete(Response.json(state));await pending;assert.equal(client.snapshot().data,null);let calls=0;const customer=createCustomerCompanyRevisionClient(id,async(url)=>{calls++;if(calls===1)throw new Error('lost');assert.equal(String(url),`/api/quote/requests/company-revision/commands/${key}`);return Response.json({receipt})},()=>key);await customer.accept({revisionId,expectedRevision:0,reviewProof:'proof',acknowledgmentVersion:COMPANY_REVISION_ACK.version,acknowledged:true,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true}});assert.equal((await customer.check()).phase,'saved')})
test('review authentication loss clears customer private state and pending input',async()=>{let first=true;const customer=createCustomerCompanyRevisionClient(id,async()=>{if(first){first=false;return Response.json(state)}return Response.json({error:'expired'},{status:401})});await customer.detail();await assert.rejects(customer.review(revisionId,'a'.repeat(64)));assert.equal(customer.client.snapshot().phase,'access_lost');assert.equal(customer.client.snapshot().data,null)})

function pricedState(){const payload={contact:{name:'Customer',email:'customer@example.invalid',phone:'',siteAddress:'1 Test Street',suburb:'Sydney',postcode:'2000',details:''},quantities:{doorCount:6,drawerCount:3,moderateRepair:false},extraItems:[],customerNote:''};const pricing=calculateCompanyRevisionPricing(payload),comparison=compareCompanyRevision({payload:{contact:payload.contact,service:{doorCount:12,drawerCount:4}},pricing:{subtotal:220000,tax:22000,total:242000,pricingVersion:'cabinet-painting-v2'}},payload);const current={id:revisionId,requestId:id,revision:2,versionNo:1,status:'published',payload,pricing,totalCents:pricing.total,comparison};return {...state,revision:2,current,revisions:[current]}}
test('admin and customer parsers preserve original signed tax and reject corrupted current or history comparisons',async()=>{
 const valid=pricedState();assert.equal(parseCompanyRevisionState(valid).current!.comparison.original.taxCents,22000)
 for(const corrupt of [{...valid.current,comparison:{...valid.current.comparison,original:{...valid.current.comparison.original,subtotalCents:1}}}]){
  assert.throws(()=>parseCompanyRevisionState({...valid,current:corrupt}))
  assert.throws(()=>parseCompanyRevisionState({...valid,revisions:[corrupt]}))
  const customer=createCustomerCompanyRevisionClient(id,async()=>Response.json({...valid,current:corrupt}));await customer.detail();assert.equal(customer.client.snapshot().data,null)
 }
 const customer=createCustomerCompanyRevisionClient(id,async()=>Response.json(valid));await customer.detail();assert.equal(customer.client.snapshot().data!.current!.comparison.original.totalCents,242000)
 for(const change of [{quantities:null},{quantities:{doorCount:-1,drawerCount:0,moderateRepair:false}},{lineItems:[null]},{lineItems:[{code:'doors',label:'Doors',quantity:1,unitAmount:'1',amount:1}]},{taxCents:null},{subtotalCents:220000.5},{pricingVersion:undefined},{taxCents:-1},{totalCents:242001}])assert.throws(()=>parseCompanyRevisionState({...valid,current:{...valid.current,comparison:{...valid.current.comparison,original:{...valid.current.comparison.original,...change}}}}))
})
