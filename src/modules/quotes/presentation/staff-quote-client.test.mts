import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {parseStaffQuoteDraft,staffQuoteActions,CurrentWorkClient} from './staff-quote-client.ts'
const id=randomUUID(),source={id,revision:4,status:'review_requested',payload:{contact:{name:'Original signed customer'}}},payload={contact:{name:'Staff copy',email:'staffcopy@example.invalid',phone:'',siteAddress:'1 Synthetic Street',suburb:'Sydney',postcode:'2000',details:''},service:null,internalNotes:'Private'}
const detail={requestId:id,source,draft:{requestId:id,status:'draft',revision:1,payload},audit:[],canWrite:true}
test('work-copy read remains distinct from read-only source and rejects another request or source-protected fields',()=>{const value=parseStaffQuoteDraft(detail);assert.equal(value.source.payload.contact.name,'Original signed customer');assert.equal(value.draft!.payload.contact.name,'Staff copy');assert.throws(()=>parseStaffQuoteDraft({...detail,draft:{...detail.draft,requestId:randomUUID()}}));assert.throws(()=>parseStaffQuoteDraft({...detail,draft:{...detail.draft,payload:{...payload,pricing:{total:1}}}}))})
test('staff save sends only explicit work-copy command to the separate draft endpoint',async()=>{const key=randomUUID();let path='',body:Record<string,unknown>={};const client=new CurrentWorkClient(parseStaffQuoteDraft,async(url,init)=>{path=String(url);body=JSON.parse(String(init?.body));return Response.json({receipt:{idempotencyKey:key,entityType:'staff_quote_draft',entityId:id,action:'quote_save',revision:1,committedAt:new Date().toISOString()}})},()=>key);assert.equal((await staffQuoteActions(client,id).save({expectedRevision:0,reason:'Staff copy',payload})).phase,'saved');assert.equal(path,`/api/admin/quote-requests/${id}/staff-draft`);assert.equal('storageConsent'in body,false);assert.deepEqual(body.payload,payload)})
test('status-filter list parser rejects malformed successful data',async()=>{const {parseStaffQuoteList}=await import('./staff-quote-client.ts');assert.throws(()=>parseStaffQuoteList({requests:[{id}],total:1,page:1,pageSize:20}));assert.deepEqual(parseStaffQuoteList({requests:[],total:0,page:1,pageSize:20}).requests,[])})
test('typed list retains nullable staffDraftRevision while preserving the source request DTO',async()=>{const {parseStaffQuoteList}=await import('./staff-quote-client.ts');const row={id,reference:'RQ-'+id.replaceAll('-','').toUpperCase(),mode:'live',companyId:'lk-group',revision:4,status:'review_requested',payload:{contact:{...payload.contact,consent:true},service:null},consentVersion:'quote-storage-review-v1',savedAt:new Date().toISOString(),createdAt:new Date().toISOString(),reviewRequestedAt:new Date().toISOString(),customerId:null,staffDraftRevision:2};const page=parseStaffQuoteList({requests:[row],total:1,page:1,pageSize:20});const revision:number|null=page.requests[0].staffDraftRevision;assert.equal(revision,2);assert.equal(page.requests[0].revision,4);assert.equal(parseStaffQuoteList({requests:[{...row,staffDraftRevision:null}],total:1,page:1,pageSize:20}).requests[0].staffDraftRevision,null);assert.throws(()=>parseStaffQuoteList({requests:[{...row,staffDraftRevision:undefined}],total:1,page:1,pageSize:20}))})
test('staff quote action default fetch keeps the browser receiver without an injected request function',async()=>{const original=globalThis.fetch,key=randomUUID();let calls=0;globalThis.fetch=async function(this:unknown,url,init){if(this!==globalThis)throw new TypeError('Illegal invocation');calls++;assert.equal(String(url),`/api/admin/quote-requests/${id}/staff-draft`);const body=JSON.parse(String(init?.body));return Response.json({receipt:{idempotencyKey:body.idempotencyKey,entityType:'staff_quote_draft',entityId:id,action:'quote_save',revision:1,committedAt:new Date().toISOString()}})};try{const client=new CurrentWorkClient(parseStaffQuoteDraft,undefined,()=>key);assert.equal((await staffQuoteActions(client,id).save({expectedRevision:0,reason:'Staff copy',payload})).phase,'saved');assert.equal(calls,1)}finally{globalThis.fetch=original}})
test('staff quote default action exposes definite503 and safe422 field errors through the shared client',async()=>{const original=globalThis.fetch;let calls=0;globalThis.fetch=async function(this:unknown){if(this!==globalThis)throw new TypeError('Illegal invocation');return ++calls===1?Response.json({error:'Paused',code:'unavailable',outcome:'not_applied'},{status:503}):Response.json({error:'Invalid email',code:'validation',outcome:'not_applied',fields:{'payload.contact.email':'Check the email.',pricing:'Forbidden'}},{status:422})};try{const client=new CurrentWorkClient(parseStaffQuoteDraft),actions=staffQuoteActions(client,id);assert.equal((await actions.save({expectedRevision:0,reason:'Staff copy',payload})).phase,'error');assert.equal(client.pendingRequest(),null);const state=await actions.save({expectedRevision:0,reason:'Explicit save',payload});assert.equal(state.phase,'error');assert.deepEqual(state.fields,{'payload.contact.email':'Check the email.'});assert.equal(state.input!.reason,'Explicit save');assert.equal(client.pendingRequest(),null)}finally{globalThis.fetch=original}})
