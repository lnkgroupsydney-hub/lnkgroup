import test, { beforeEach, after } from 'node:test'
import assert from 'node:assert/strict'
import { createHmac, randomUUID } from 'node:crypto'
import { customerAuthProvider, customerAuthStore } from './infrastructure/customer-auth-provider.ts'
import { QuoteRequestError } from './domain/contracts.ts'
const provider='https://customer-auth.invalid',uid=randomUUID(),sid=randomUUID(),signingKey='synthetic-customer-provider-test'
const envKeys=['NEXT_PUBLIC_SUPABASE_URL','NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY','SUPABASE_SECRET_KEY','OPERATIONS_STORE'] as const
const old=Object.fromEntries(envKeys.map(key=>[key,process.env[key]])),originalFetch=globalThis.fetch
let active=true,fail=false,codeFailure=false,accountEmail='alice@example.invalid',confirmed=true,anonymous=false
let calls:string[]=[],claimExtras:Record<string,unknown>={}
function jwt(){const header=Buffer.from(JSON.stringify({alg:'HS256',typ:'JWT'})).toString('base64url'),payload=Buffer.from(JSON.stringify({iss:`${provider}/auth/v1`,aud:'authenticated',sub:uid,session_id:sid,aal:'aal1',exp:Math.floor(Date.now()/1000)+3600,iat:Math.floor(Date.now()/1000),...claimExtras})).toString('base64url');return `${header}.${payload}.${createHmac('sha256',signingKey).update(`${header}.${payload}`).digest('base64url')}`}
function user(){return{id:uid,aud:'authenticated',email:accountEmail,email_confirmed_at:confirmed?new Date().toISOString():null,created_at:new Date().toISOString(),is_anonymous:anonymous,app_metadata:{},user_metadata:{lk_staff:{role:'owner'},email_verified:true}}}
globalThis.fetch=async(input,init)=>{
 const req=new Request(input,init),url=new URL(req.url);assert.equal(url.origin,provider,'No real network request is allowed');calls.push(`${req.method} ${url.pathname}`)
 if(url.pathname==='/auth/v1/otp'){assert.equal(req.headers.get('apikey'),'synthetic-publishable');const body=await req.json();assert.equal(body.email,'alice@example.invalid');assert.equal(body.create_user,true);return fail?Response.json({code:'over_email_send_rate_limit',message:'PRIVATE_DIAGNOSTIC'},{status:429}):Response.json({})}
 if(url.pathname==='/auth/v1/verify'){const body=await req.json();assert.equal(body.type,'email');assert.equal(body.token,'12345678');return codeFailure?Response.json({code:'otp_expired',message:'PRIVATE_OTP_DETAIL'},{status:403}):Response.json({access_token:jwt(),refresh_token:'DO_NOT_EXPOSE_REFRESH',expires_in:3600,token_type:'bearer',user:user()})}
 if(url.pathname==='/auth/v1/user'){const token=req.headers.get('authorization')?.slice(7)??'',pieces=token.split('.');if(pieces.length!==3||pieces[2]!==createHmac('sha256',signingKey).update(`${pieces[0]}.${pieces[1]}`).digest('base64url'))return Response.json({message:'Invalid JWT',code:'bad_jwt'},{status:401});return Response.json(user())}
 if(url.pathname==='/rest/v1/rpc/lk_quote_customer_auth_session_active'){assert.equal(req.headers.get('apikey'),'synthetic-server-secret');const body=await req.json();assert.deepEqual(body,{input_session_id:sid,input_user_id:uid});return fail?Response.json({code:'XX000',message:'PRIVATE_SESSION_DIAGNOSTIC'},{status:400}):Response.json(active)}
 if(url.pathname==='/rest/v1/rpc/lk_quote_customer_command')return Response.json({code:fail?'XX000':'LK409',message:fail?'PRIVATE_STORAGE_DIAGNOSTIC':'Saved request changed.'},{status:400})
 throw new Error('Unexpected transport path '+url.pathname)
}
beforeEach(()=>{Object.assign(process.env,{NEXT_PUBLIC_SUPABASE_URL:provider,NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:'synthetic-publishable',SUPABASE_SECRET_KEY:'synthetic-server-secret',OPERATIONS_STORE:'supabase'});active=true;fail=false;codeFailure=false;accountEmail='alice@example.invalid';confirmed=true;anonymous=false;calls=[];claimExtras={}})
after(()=>{globalThis.fetch=originalFetch;for(const key of envKeys){if(old[key]===undefined)delete process.env[key];else process.env[key]=old[key]}})
const status=(expected:number)=>(error:unknown)=>error instanceof QuoteRequestError&&error.status===expected&&!error.message.includes('PRIVATE_')
test('customer OTP uses publishable Auth SDK and accepts configured 8-digit codes; verified session excludes refresh token',async()=>{await customerAuthProvider.send('alice@example.invalid');const identity=await customerAuthProvider.verify('alice@example.invalid','12345678');assert.equal(identity.userId,uid);assert.equal(identity.email,'alice@example.invalid');assert.equal(identity.authSessionId,sid);assert.ok(identity.accessToken);assert.ok(!JSON.stringify(identity).includes('DO_NOT_EXPOSE_REFRESH'));assert.ok(calls.includes('GET /auth/v1/user'));assert.ok(calls.includes('POST /rest/v1/rpc/lk_quote_customer_auth_session_active'))})
test('active upstream Auth session is checked every customer identity request; revoked sessions cannot use valid JWT',async()=>{await customerAuthProvider.identity(jwt());active=false;await assert.rejects(customerAuthProvider.identity(jwt()),status(401))})
test('unconfirmed/anonymous identities and invalid issuer/audience/subject cannot obtain customer access',async()=>{confirmed=false;await assert.rejects(customerAuthProvider.identity(jwt()),status(401));confirmed=true;anonymous=true;await assert.rejects(customerAuthProvider.identity(jwt()),status(401));anonymous=false;for(const extra of [{iss:'https://evil.invalid/auth/v1'},{aud:'anon'},{sub:randomUUID()},{session_id:'forged'}]){claimExtras=extra;await assert.rejects(customerAuthProvider.identity(jwt()),status(401))}})
test('wrong/expired OTP, provider rate limits and storage errors retain safe error messages',async()=>{codeFailure=true;await assert.rejects(customerAuthProvider.verify('alice@example.invalid','12345678'),status(401));codeFailure=false;fail=true;await assert.rejects(customerAuthProvider.send('alice@example.invalid'),status(429));await assert.rejects(customerAuthProvider.identity(jwt()),status(503));await assert.rejects(customerAuthStore.command('state',{}),status(503));fail=false;await assert.rejects(customerAuthStore.command('complete',{}),status(409))})
