import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {parseCancellation,simpleBookingActions,CurrentWorkClient} from './simple-booking-client.ts'
import {companyProcessingRetryable} from './live-booking-client.ts'
import {scheduleStatus,scheduleStatusLabels} from './admin-schedule-view.ts'
import type {SimpleBookingManagement} from '../domain/simple-management.ts'
import type {LiveCompanyBookingState} from '../domain/live-contracts.ts'
const id=randomUUID(),key=randomUUID(),cancellation={id:randomUUID(),requestId:id,bookingId:randomUUID(),status:'retrying',occupancyHeld:true,totalEvents:2,verifiedDeletedEvents:1}
test('pending cancellation keeps occupancy visible; cancelled and pending states cannot trigger confirmation delivery retry',()=>{assert.equal(parseCancellation(cancellation)!.occupancyHeld,true);assert.throws(()=>parseCancellation({...cancellation,status:'cancelled'}));for(const status of ['cancel_pending','cancelled'] as const){const state={booking:{status,emailStatus:'retrying'}} as LiveCompanyBookingState;assert.equal(companyProcessingRetryable(state),false);assert.equal(scheduleStatus(state),status);assert.match(scheduleStatusLabels[status],status==='cancelled'?/released/:/held/)}})
test('Save draft posts nullable fields to draft endpoint and cancel dialog dismissal has no side effect',async()=>{let calls=0,body:Record<string,unknown>={};const client=new CurrentWorkClient<SimpleBookingManagement>(v=>v as SimpleBookingManagement,async(_url,init)=>{calls++;body=JSON.parse(String(init?.body));return Response.json({receipt:{idempotencyKey:key,entityType:'simple_booking',entityId:id,action:'booking_save',revision:1,committedAt:new Date().toISOString()}})},()=>key),actions=simpleBookingActions(client,id);assert.equal(calls,0);await actions.save({expectedRevision:0,reason:'Undecided time',takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''});assert.equal(calls,1);assert.equal(body.installStartLocal,null);assert.equal('takeOffStartLocal'in body,false)})
test('saved nullable simple draft is shown as draft before confirmation',()=>{assert.equal(scheduleStatus({booking:null,proposal:null,simpleDraft:{companyNote:'Saved'}} as LiveCompanyBookingState),'draft')})
test('simple booking action default fetch keeps the browser receiver without an injected request function',async()=>{const original=globalThis.fetch;let calls=0;globalThis.fetch=async function(this:unknown,url,init){if(this!==globalThis)throw new TypeError('Illegal invocation');calls++;assert.equal(String(url),`/api/admin/live-bookings/${id}/draft`);const body=JSON.parse(String(init?.body));return Response.json({receipt:{idempotencyKey:body.idempotencyKey,entityType:'simple_booking',entityId:id,action:'booking_save',revision:1,committedAt:new Date().toISOString()}})};try{const client=new CurrentWorkClient<SimpleBookingManagement>(value=>value as SimpleBookingManagement,undefined,()=>key);assert.equal((await simpleBookingActions(client,id).save({expectedRevision:0,reason:'Undecided time',takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''})).phase,'saved');assert.equal(calls,1)}finally{globalThis.fetch=original}})
test('simple booking default actions retain unknown retry keys through503 and expose safe422 fields after resolution',async()=>{const original=globalThis.fetch;let writes=0,originalKey='';globalThis.fetch=async function(this:unknown,_url,init){if(this!==globalThis)throw new TypeError('Illegal invocation');if(!init?.method)return Response.json({receipt:{idempotencyKey:originalKey,entityType:'simple_booking',entityId:id,action:'booking_save',revision:1,committedAt:new Date().toISOString()}});const body=JSON.parse(String(init.body));if(++writes===1){originalKey=body.idempotencyKey;throw Error('response lost')}if(writes===2){assert.equal(body.idempotencyKey,originalKey);return Response.json({error:'Paused',code:'unavailable',outcome:'not_applied'},{status:503})}return Response.json({error:'Invalid note',code:'validation',outcome:'not_applied',fields:{companyNote:'Check the note.',takeOffStartLocal:'Read only'}},{status:422})};try{const client=new CurrentWorkClient<SimpleBookingManagement>(value=>value as SimpleBookingManagement),actions=simpleBookingActions(client,id),input={expectedRevision:0,reason:'Undecided time',takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''};assert.equal((await actions.save(input)).phase,'unknown');assert.equal((await actions.retry()).phase,'unknown');assert.equal(client.pendingRequest()!.body.idempotencyKey,originalKey);assert.equal((await actions.check()).phase,'saved');const state=await actions.save(input);assert.equal(state.phase,'error');assert.deepEqual(state.fields,{companyNote:'Check the note.'});assert.equal(client.pendingRequest(),null)}finally{globalThis.fetch=original}})
