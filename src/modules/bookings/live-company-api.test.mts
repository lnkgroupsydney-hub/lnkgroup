import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {createLiveCompanyBookingApi,type LiveCompanyBookingApiDependencies} from './infrastructure/live-api.ts'
import {validateLiveProposal} from './domain/live-validation.ts'
import {sydneyLocalToInstant} from '../operations/access.ts'
import {QuoteRequestError,type QuoteRequestOwner} from '../quotes/domain/contracts.ts'
import type {LiveCompanyBookingState,LiveCompanyProposal} from './domain/live-contracts.ts'
const base='http://127.0.0.1:3002',requestId=randomUUID(),proposalId=randomUUID(),userId=randomUUID(),sessionId=randomUUID(),hash='a'.repeat(64),now=Date.parse('2026-10-13T00:00:00Z')
const target={accountSub:'company-sub',calendarId:'lnkgroupsydney@gmail.com'},segments=validateLiveProposal({amountExGst:150000,scope:'Paint existing fronts.',adjustmentReason:'Site scope verified.',segments:[{kind:'all_day',startDate:'2030-01-05',endDate:'2030-01-07'}]},sydneyLocalToInstant,now).segments
const proposal:LiveCompanyProposal={id:proposalId,version:1,revision:1,status:'published',hash,amountExGst:150000,gst:15000,total:165000,currency:'AUD',scope:'Paint existing fronts.',adjustmentReason:'Site scope verified.',segments,calendarTarget:target,createdAt:new Date(now).toISOString(),publishedAt:new Date(now).toISOString(),emailStatus:'provider_accepted',receiptReady:true}
const owner:QuoteRequestOwner={hash:'b'.repeat(64),expiresAt:new Date(now+3600000).toISOString(),customer:{companyId:'lk-group',sessionId,authUserId:userId,email:'alice@example.invalid',requestId}}
const state={requestId,revision:3,submission:{snapshot:{photos:[{objectPath:'private/photo'}],inputSnapshot:{private:'secret'}}},proposal,proposals:[proposal],acceptance:null,booking:null,acknowledgment:{version:'company-price-schedule-ack-v1',text:'Noncontract price and schedule acknowledgment.'}} as unknown as LiveCompanyBookingState
function setup(overrides:Partial<LiveCompanyBookingApiDependencies>={}){
 const calls:{command:string;args:Record<string,unknown>}[]=[],enqueued:string[]=[],permissions:string[]=[]
 const deps:LiveCompanyBookingApiDependencies={store:{async command<T>(command,args){calls.push({command,args});if(command==='customer_review')return {proposal,acknowledgment:state.acknowledgment} as T;return state as T}},now:()=>now,key:()=>hash,enabled:()=>true,baseUrl:()=>base,staff:async(_req,permission)=>{permissions.push(permission);return {companyId:'lk-group',userId,sessionId}},readOwner:async()=>owner,writeOwner:async()=>owner,target:async()=>target,check:async()=>({...target,checkedAt:new Date(now).toISOString(),expiresAt:new Date(now+60000).toISOString(),revision:'availability',conflicts:[]}),reconcile:async()=>({ok:true}),enqueue:id=>enqueued.push(id),...overrides}
 return {api:createLiveCompanyBookingApi(deps),calls,enqueued,permissions}
}
const request=(path:string,body?:unknown,headers:Record<string,string>={})=>new Request(base+path,{method:body===undefined?'GET':'POST',headers:{host:new URL(base).host,origin:base,'content-type':'application/json',...headers},...(body===undefined?{}:{body:JSON.stringify(body)})})
const cmd={expectedRevision:3,proposalId,proposalHash:hash,idempotencyKey:randomUUID()}
test('read requests without submitted source return nullable state; staff reads use operations.read',async()=>{const s=setup({store:{command:async<T>()=>null as T}});const r=await s.api.list(request('/api/admin/live-bookings?requestId='+requestId));assert.equal(r.status,200);assert.deepEqual(await r.json(),{state:null});assert.deepEqual(s.permissions,['operations.read'])})
test('staff draft uses operations.write and same-origin gate before Calendar access',async()=>{const s=setup();const body={expectedRevision:0,idempotencyKey:randomUUID(),amountExGst:150000,scope:'Paint fronts.',adjustmentReason:'Manual site adjustment.',segments:[{kind:'all_day',startDate:'2030-01-05',endDate:'2030-01-07'}]};assert.equal((await s.api.draft(request('/proposal',body,{origin:'https://evil.invalid'}),requestId)).status,403);assert.equal(s.permissions.length,0);assert.equal((await s.api.draft(request('/proposal',body),requestId)).status,200);assert.deepEqual(s.permissions,['operations.write']);assert.equal(s.calls[0].args.actorUserId,userId);assert.equal((s.calls[0].args.proposal as {amountExGst:number}).amountExGst,150000)})
test('staff confirm rejects Calendar conflicts before DB hold and enqueues only after successful transaction',async()=>{const conflict=setup({check:async()=>({...target,checkedAt:new Date(now).toISOString(),expiresAt:new Date(now+60000).toISOString(),revision:'busy',conflicts:[{segmentIndex:0,source:'google',startAt:segments[0].startAt,endAt:segments[0].endAt,message:'Busy'}]})});assert.equal((await conflict.api.confirm(request('/confirm',cmd),requestId)).status,409);assert.equal(conflict.calls.some(x=>x.command==='staff_confirm'),false);assert.deepEqual(conflict.enqueued,[]);const good=setup();assert.equal((await good.api.confirm(request('/confirm',cmd),requestId)).status,202);assert.equal(good.calls.at(-1)!.command,'staff_confirm');assert.equal((good.calls.at(-1)!.args.calendarCheck as {proposalHash:string}).proposalHash,hash);assert.deepEqual(good.enqueued,[requestId])})
test('existing confirmation retry avoids Google check and retains original DB state',async()=>{let checks=0;const s=setup({store:{command:async<T>()=>({...state,booking:{id:randomUUID(),proposalId,proposalHash:hash,status:'confirming'}} as T)},check:async()=>{checks++;throw new Error('offline')}});assert.equal((await s.api.confirm(request('/confirm',cmd),requestId)).status,202);assert.equal(checks,0)})
test('published replay reaches durable receipt without requiring new Google availability',async()=>{const s=setup({check:async()=>{throw new Error('offline')}});assert.equal((await s.api.publish(request('/publish',cmd),requestId)).status,200);assert.equal(s.calls.at(-1)!.command,'staff_publish');assert.equal(s.calls.at(-1)!.args.calendarCheck,undefined)})
test('guest quote cookie cannot access or accept company proposal',async()=>{const guest=setup({readOwner:async()=>({...owner,customer:undefined}),writeOwner:async()=>({...owner,customer:undefined})});assert.equal((await guest.api.customerState(request('/company-booking'))).status,403);assert.equal((await guest.api.review(request('/review',{proposalId,proposalHash:hash}))).status,403);assert.equal(guest.calls.length,0)})
test('encrypted review binds exact proposal and verified identity; signature is separate from prior request',async()=>{const s=setup(),review=await s.api.review(request('/review',{proposalId,proposalHash:hash}));assert.equal(review.status,200);const row=await review.json();const signature={name:'Synthetic customer',method:'typed',strokes:[],acknowledged:true};const accepted=await s.api.accept(request('/accept',{reviewProof:row.review.reviewProof,signature,idempotencyKey:randomUUID()}));assert.equal(accepted.status,200);const command=s.calls.at(-1)!;assert.equal(command.command,'customer_accept');assert.equal(command.args.proposalHash,hash);assert.deepEqual(command.args.signature,signature);const wrong=setup({writeOwner:async()=>({...owner,hash:'c'.repeat(64)})});assert.equal((await wrong.api.accept(request('/accept',{reviewProof:row.review.reviewProof,signature,idempotencyKey:randomUUID()}))).status,403);assert.equal(wrong.calls.length,0)})
test('tampered review proof cannot mutate acceptance or queue email',async()=>{const s=setup();const review=(await(await s.api.review(request('/review',{proposalId,proposalHash:hash}))).json()).review;const proof=review.reviewProof.slice(0,-4)+'AAAA';assert.equal((await s.api.accept(request('/accept',{reviewProof:proof,signature:{name:'Customer',method:'typed',strokes:[],acknowledged:true},idempotencyKey:randomUUID()}))).status,409);assert.deepEqual(s.enqueued,[])})
test('public state excludes private photo paths/input and company event ownership details',async()=>{const s=setup({store:{command:async<T>()=>({...state,booking:{events:[{eventId:'private-owned-event'}]}} as T)}});const body=JSON.stringify(await(await s.api.customerState(request('/company-booking'))).json());assert.equal(body.includes('private/photo'),false);assert.equal(body.includes('private-owned-event'),false);assert.equal(body.includes('inputSnapshot'),false)})
test('manual timed/all-day intervals share UTC overlap rules and exclusive Sydney date projections',()=>{const timed=validateLiveProposal({amountExGst:12345,scope:'Scope',adjustmentReason:'Reason',segments:[{kind:'timed',startLocal:'2030-01-05T22:00',endLocal:'2030-01-06T00:00'}]},sydneyLocalToInstant,now);assert.equal(timed.segments[0].startAt,'2030-01-05T11:00:00.000Z');assert.equal(timed.segments[0].endDate,'2030-01-06');assert.throws(()=>validateLiveProposal({amountExGst:1,scope:'Scope',adjustmentReason:'Reason',segments:[{kind:'all_day',startDate:'2030-01-05',endDate:'2030-01-06'},{kind:'timed',startLocal:'2030-01-05T09:00',endLocal:'2030-01-05T10:00'}]},sydneyLocalToInstant,now),/overlap/)})
test('Sydney daylight saving ambiguous/nonexistent times and invalid pricing/scope periods reject before storage',()=>{for(const startLocal of ['2027-04-04T02:30','2027-10-03T02:30'])assert.throws(()=>validateLiveProposal({amountExGst:1,scope:'Scope',adjustmentReason:'Reason',segments:[{kind:'timed',startLocal,endLocal:startLocal.slice(0,10)+'T04:00'}]},sydneyLocalToInstant,now),/ambiguous/);for(const amountExGst of [-1,0,NaN,Infinity,1.25,100000001])assert.throws(()=>validateLiveProposal({amountExGst,scope:'Scope',adjustmentReason:'Reason',segments:[{kind:'all_day',startDate:'2030-01-05',endDate:'2030-01-06'}]},sydneyLocalToInstant,now),QuoteRequestError)})
test('disabled mutations and unsupported signature payloads never write proposals',async()=>{const off=setup({enabled:()=>false});assert.equal((await off.api.confirm(request('/confirm',cmd),requestId)).status,503);assert.equal(off.calls.length,0);const s=setup();assert.equal((await s.api.draft(request('/proposal',{extra:1}),requestId)).status,400);assert.equal(s.calls.length,0)})

const simpleCommand={expectedRevision:0,idempotencyKey:randomUUID(),takeOffEndLocal:'2030-01-05T10:00',installStartLocal:'2030-01-09T09:00',installEndLocal:'2030-01-09T11:00',companyNote:'Any additional site damage and cost will be discussed before work.'}
async function simpleSetup(conflicting=false,booking=false){
 const {bookingAcknowledgment,BOOKING_SIMPLE_ACK_VERSION}=await import('../quotes/domain/booking-flow.ts')
 const calls:{command:string;args:Record<string,unknown>}[]=[],checked:unknown[]=[],queued:string[]=[]
 const simpleState={...state,revision:0,submission:{...state.submission,preferredDate:'2030-01-05',preferredTime:'09:00',snapshot:{...state.submission.snapshot,version:BOOKING_SIMPLE_ACK_VERSION,preferredDate:'2030-01-05',preferredTime:'09:00',acknowledgment:bookingAcknowledgment()}} ,proposal:null,proposals:[],booking:booking?{id:randomUUID(),confirmationBasis:'signed_request'}:null} as LiveCompanyBookingState
 const prepared={...proposal,status:'published',confirmationBasis:'signed_request',companyNote:simpleCommand.companyNote,segments:[{kind:'timed',purpose:'take_off',startAt:'2030-01-04T22:00:00.000Z',endAt:'2030-01-04T23:00:00.000Z',startDate:'2030-01-05',endDate:'2030-01-06',startLocal:'2030-01-05T09:00',endLocal:'2030-01-05T10:00'},{kind:'timed',purpose:'install',startAt:'2030-01-08T22:00:00.000Z',endAt:'2030-01-09T00:00:00.000Z',startDate:'2030-01-09',endDate:'2030-01-10',startLocal:'2030-01-09T09:00',endLocal:'2030-01-09T11:00'}]} as LiveCompanyProposal
 const s=setup({store:{async command<T>(command,args){calls.push({command,args});return(command==='staff_prepare_request'?prepared:simpleState) as T}},check:async(target,periods)=>{checked.push({target,periods});return{...target,revision:'v2-availability',checkedAt:new Date(now).toISOString(),expiresAt:new Date(now+60000).toISOString(),conflicts:conflicting?[{segmentIndex:1,source:'google',startAt:prepared.segments[1].startAt,endAt:prepared.segments[1].endAt,message:'Busy'}]:[]}},enqueue:id=>queued.push(id)})
 return {...s,calls,checked,queued,simpleState}
}
test('single EMS button prepares protected original request, checks both periods, commits once and enqueues without customer acceptance',async()=>{
 const s=await simpleSetup(),response=await s.api.confirmRequest(request('/confirm-request',simpleCommand),requestId);assert.equal(response.status,202,await response.clone().text())
 assert.deepEqual(s.permissions,['operations.write']);assert.deepEqual(s.calls.map(c=>c.command),['staff_state','staff_prepare_request','staff_confirm_request']);assert.equal(s.checked.length,1)
 const cmd=s.calls.at(-1)!;assert.equal((cmd.args.calendarCheck as {proposalHash:string}).proposalHash,hash);assert.equal(cmd.args.companyNote,simpleCommand.companyNote);assert.equal(Object.hasOwn(cmd.args,'amountExGst'),false);assert.equal(Object.hasOwn(cmd.args,'takeOffStartLocal'),false);assert.deepEqual(s.queued,[requestId])
})
test('single confirmation rejects forged amount/start fields, cross origin, mismatched source and invalid intervals before any Calendar allocation',async()=>{
 for(const extra of [{amountExGst:1},{takeOffStartLocal:'2030-01-05T08:00'},{preferredTime:'08:00'},{segments}]){const s=await simpleSetup();assert.equal((await s.api.confirmRequest(request('/confirm-request',{...simpleCommand,...extra}),requestId)).status,400);assert.equal(s.calls.length,0)}
 const s=await simpleSetup();assert.equal((await s.api.confirmRequest(request('/confirm-request',simpleCommand,{origin:'https://evil.invalid'}),requestId)).status,403);assert.equal(s.calls.length,0)
 const legacy=setup();assert.equal((await legacy.api.confirmRequest(request('/confirm-request',simpleCommand),requestId)).status,409)
 const bad=await simpleSetup();assert.equal((await bad.api.confirmRequest(request('/confirm-request',{...simpleCommand,installStartLocal:'2030-01-05T09:30'}),requestId)).status,400);assert.equal(bad.checked.length,0)
})
test('an install conflict prevents the single confirm transaction; successful response-loss replay skips all external Calendar calls',async()=>{
 const bad=await simpleSetup(true);assert.equal((await bad.api.confirmRequest(request('/confirm-request',simpleCommand),requestId)).status,409);assert.equal(bad.calls.some(c=>c.command==='staff_confirm_request'),false);assert.deepEqual(bad.queued,[])
 const replay=await simpleSetup(false,true);assert.equal((await replay.api.confirmRequest(request('/confirm-request',simpleCommand),requestId)).status,202);assert.deepEqual(replay.calls.map(c=>c.command),['staff_state','staff_confirm_request']);assert.equal(replay.checked.length,0)
})
test('same single-confirm body with surrounding note whitespace has identical first and response-loss replay command payloads',async()=>{
 const body={...simpleCommand,companyNote:'  '+simpleCommand.companyNote+'  '},first=await simpleSetup(),replayed=await simpleSetup(false,true)
 assert.equal((await first.api.confirmRequest(request('/confirm-request',body),requestId)).status,202)
 assert.equal((await replayed.api.confirmRequest(request('/confirm-request',body),requestId)).status,202)
 const before={...first.calls.at(-1)!.args};delete before.calendarCheck
 assert.deepEqual(before,replayed.calls.at(-1)!.args);assert.equal(before.companyNote,simpleCommand.companyNote)
})
