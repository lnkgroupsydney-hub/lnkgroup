import test,{after,beforeEach} from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {currentWorkDb,resetCurrentWork,currentWorkRpc,workDbFailure as fail,tableHash} from '../enquiries/infrastructure/management-test-fixtures.mts'
import {seedCompanyFixture,companyRpc,companyProof,fixtureHash} from './infrastructure/live-test-fixtures.mts'
import {liveCompanyEventPlan} from './live-calendar.ts'
import type {LiveCompanyBookingState,LiveCompanyWorkerClaim} from './domain/live-contracts.ts'
import type {CancellationClaim,SimpleBookingManagement} from './domain/simple-management.ts'
import type {WorkReceipt} from '../enquiries/management.ts'
const db=await currentWorkDb();beforeEach(()=>resetCurrentWork(db));after(()=>db.close())
const rpc=<T=Record<string,unknown>>(cmd:string,args:Record<string,unknown>)=>currentWorkRpc<T>(db,cmd,args)
const booking=<T=LiveCompanyBookingState>(cmd:string,args:Record<string,unknown>)=>companyRpc<T>(db,cmd,args)
const times={takeOffEndLocal:'2030-01-01T10:00',installStartLocal:'2030-01-08T09:00',installEndLocal:'2030-01-08T11:00',companyNote:'Original price; damage and installation guidance'}
async function seed(){return seedCompanyFixture(db,{simple:true})}
const args=(f:Awaited<ReturnType<typeof seed>>,rev=0)=>({id:f.requestId,actorUserId:f.staffId,actorSessionId:f.staffSessionId,expectedRevision:rev,idempotencyKey:randomUUID(),reason:'Booking work management'})
async function confirm(f:Awaited<ReturnType<typeof seed>>,rev=0){const input={...f.staffArgs,...times,expectedRevision:rev,idempotencyKey:randomUUID()},prepared=await booking<{hash:string}>('staff_prepare_request',input);return{input,state:await booking('staff_confirm_request',{...input,calendarCheck:companyProof(prepared.hash)})}}
async function verified(f:Awaited<ReturnType<typeof seed>>,complete=true){const confirmed=await confirm(f),leaseToken=randomUUID(),claim=await booking<LiveCompanyWorkerClaim>('worker_claim',{requestId:f.requestId,leaseToken});const lease={id:claim.id,leaseToken};for(let i=0;i<2;i++){const plan=liveCompanyEventPlan({booking:confirmed.state.booking!,proposal:confirmed.state.proposal!,reference:confirmed.state.submission.reference},i);await booking('record_event',{...lease,segmentIndex:i,eventId:plan.payload.id,payloadHash:plan.payloadHash,etag:'"verified-'+i+'"'})}await booking('finish_calendar',{...lease,calendarCheck:companyProof(confirmed.state.proposal!.hash)});if(complete){await booking('freeze_mail',{...lease,pdfBase64:Buffer.from('%PDF-frozen').toString('base64'),pdfHash:fixtureHash('%PDF-frozen'),payload:{to:[f.email],subject:'Immutable confirmation'}});await booking('email_attempt',lease);await booking('mail_result',{...lease,providerMessageId:'accepted-confirmation'})}return{...confirmed,lease}}
const workerLease=(claim:CancellationClaim)=>({id:claim.id,bookingId:claim.bookingId,proposalHash:claim.proposalHash,leaseToken:claim.leaseToken})
const proof=(claim:CancellationClaim,i:number)=>({segmentIndex:i,eventId:claim.manifest[i].eventId,resultCode:'absent_404',verifiedAt:new Date().toISOString()})
test('incomplete nullable draft saves without Calendar target, holds, outbox, proposal, mail or original content changes',async()=>{const f=await seed(),tables=['lk_quote_requests','lk_live_quote_submissions','lk_live_company_proposals','lk_live_company_bookings','lk_live_company_outbox','lk_live_booking_confirmed_segments'],before=await Promise.all(tables.map(t=>tableHash(db,t)));await db.exec('reset role');await db.exec('delete from public.lk_google_connection');await db.exec('set role service_role');const input={...args(f),takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''},receipt=await rpc<{receipt:WorkReceipt}>('booking_save',input);assert.equal(receipt.receipt.revision,1);assert.deepEqual(await rpc('booking_save',input),receipt);assert.deepEqual(await Promise.all(tables.map(t=>tableHash(db,t))),before);const detail=await rpc<SimpleBookingManagement>('booking_detail',args(f));assert.equal(detail.state.revision,1);assert.equal(detail.draft!.takeOffEndLocal,null);assert.equal(detail.draft!.signedSnapshotHash,f.snapshot?detail.state.submission.signedContentHash:'');await assert.rejects(rpc('booking_save',{...args(f),...times}),fail('LK409'))})
test('saved draft uses existing booking revision for one-click confirmation and preserves response-loss replay',async()=>{const f=await seed();await rpc('booking_save',{...args(f),...times});await assert.rejects(confirm(f,0),fail('LK409'));const{input,state}=await confirm(f,1);assert.equal(state.revision,2);assert.equal(state.booking!.status,'confirming');assert.equal((await booking('staff_confirm_request',input)).booking!.id,state.booking!.id);await assert.rejects(rpc('booking_save',{...args(f,2),...times}),fail('LK409'))})
test('draft SQL rejects protected source fields, invalid Sydney DST, reversed boundaries and v1 submissions',async()=>{const f=await seed();for(const extra of [{takeOffStartLocal:'2030-01-01T08:00'},{amountExGst:1},{takeOffEndLocal:'2030-01-01T08:00'},{installStartLocal:'2030-04-07T02:30'},{installEndLocal:'2029-12-01T10:00'}])await assert.rejects(rpc('booking_save',{...args(f),...times,...extra}),e=>fail('LK422')(e)||fail('LK400')(e));const old=await seedCompanyFixture(db,{simple:false});await assert.rejects(rpc('booking_save',{...args(old),...times}),fail('LK409'))})
test('cancel starts only after confirmed exact manifest and fully completed confirmation mail with no live or expired lease',async()=>{const f=await seed(),v=await verified(f,false);await assert.rejects(rpc('booking_cancel',args(f,1)),fail('LK409'));await booking('freeze_mail',{...v.lease,pdfBase64:Buffer.from('%PDF-frozen').toString('base64'),pdfHash:fixtureHash('%PDF-frozen'),payload:{to:[f.email]}});await booking('email_attempt',v.lease);await booking('mail_result',{...v.lease,providerMessageId:'accepted'});await db.exec('reset role');await db.query("update public.lk_live_company_outbox set lease_token=$1,lease_expires_at=now()-interval '1 second' where request_id=$2",[randomUUID(),f.requestId]);await db.exec('set role service_role');await assert.rejects(rpc('booking_cancel',args(f,1)),fail('LK409'));await db.exec('reset role');await db.query('update public.lk_live_company_outbox set lease_token=null,lease_expires_at=null where request_id=$1',[f.requestId]);await db.exec('set role service_role');const accepted=await rpc<{receipt:WorkReceipt}>('booking_cancel',args(f,1));assert.equal(accepted.receipt.revision,2);assert.ok(accepted.receipt.childId);assert.equal((await booking('customer_state',f.customerArgs)).booking!.status,'cancel_pending')})
test('partial Google evidence retains both holds; durable lease, final proof and exact booking release fence cancellation',async()=>{const f=await seed(),v=await verified(f),sourceTables=['lk_quote_requests','lk_live_quote_submissions','lk_live_company_proposals','lk_live_company_outbox','lk_live_company_events','lk_quote_request_access'],hashes=await Promise.all(sourceTables.map(t=>tableHash(db,t)));const input=args(f,1),receipt=await rpc('booking_cancel',input);const leaseToken=randomUUID(),claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken});assert.equal(await rpc('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()}),null);const lease=workerLease(claim);await assert.rejects(rpc('cancel_worker_record',{...lease,leaseToken:randomUUID(),...proof(claim,0)}),fail('LK409'));await rpc('cancel_worker_record',{...lease,...proof(claim,0)});await assert.rejects(rpc('cancel_worker_finish',{...lease,finalProof:[proof(claim,0),proof(claim,1)]}),fail('LK409'));assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments where booking_id=$1',[claim.bookingId])).rows[0].n,2);await rpc('cancel_worker_record',{...lease,...proof(claim,1)});await rpc('cancel_worker_finish',{...lease,finalProof:[proof(claim,0),proof(claim,1)]});assert.equal((await booking('customer_state',f.customerArgs)).booking!.status,'cancelled');assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments where booking_id=$1',[claim.bookingId])).rows[0].n,0);assert.deepEqual(await Promise.all(sourceTables.map(t=>tableHash(db,t))),hashes);assert.deepEqual(await rpc('booking_cancel',input),receipt);await assert.rejects(rpc('cancel_worker_finish',{...lease,finalProof:[proof(claim,0),proof(claim,1)]}),fail('LK409'));await assert.rejects(booking('staff_confirm_request',v.input),fail('LK409'));await assert.rejects(booking('staff_retry',f.staffArgs),fail('LK409'));assert.equal((await booking('reconcile_result',{bookingId:claim.bookingId,ok:false,error:'Late stale result'})).booking!.status,'cancelled');await assert.rejects(booking('worker_error',{...v.lease,stage:'calendar',outcome:'manual_review',error:'stale'}),fail('LK409'));const customer=JSON.stringify(await booking('customer_state',f.customerArgs));for(const privateField of ['actorSessionId','leaseToken','cancellationId','Booking work management'])assert.equal(customer.includes(privateField),false);assert.deepEqual((await booking<{states:unknown[]}>('reconcile_batch',{})).states,[])})
test('retrying cancellation retains exact identity and old lease is fenced after re-claim; new actor cannot continue old command',async()=>{const f=await seed();await verified(f);const input=args(f,1);await rpc('booking_cancel',input);let claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()});const old=workerLease(claim);await rpc('cancel_worker_error',{...old,status:'retrying',errorCode:'calendar_outcome_unknown'});assert.deepEqual(await rpc('booking_cancel_retry',{...f.staffArgs,id:f.requestId,idempotencyKey:input.idempotencyKey}),await rpc('booking_cancel',input));const other=await seedCompanyFixture(db);await assert.rejects(rpc('booking_cancel_retry',{id:f.requestId,actorUserId:other.staffId,actorSessionId:other.staffSessionId,idempotencyKey:input.idempotencyKey}),fail('LK404'));await db.exec('reset role');await db.query("update public.lk_live_company_cancellations set next_attempt_at=now()-interval '1 second' where id=$1",[claim.id]);await db.exec('set role service_role');claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()});assert.notEqual(claim.leaseToken,old.leaseToken);await assert.rejects(rpc('cancel_worker_record',{...old,...proof(claim,0)}),fail('LK409'));assert.equal((await rpc<{cancellation:{occupancyHeld:boolean}}>('booking_cancellation',args(f))).cancellation.occupancyHeld,true)})
test('completion releases only this booking and keeps unrelated occupancy plus original frozen confirmation PDF',async()=>{const f=await seed();await verified(f);const unrelated=await seedCompanyFixture(db,{simple:true,preferredDate:'2030-02-01'}),input={...unrelated.staffArgs,...times,takeOffEndLocal:'2030-02-01T10:00',installStartLocal:'2030-02-08T09:00',installEndLocal:'2030-02-08T11:00',expectedRevision:0,idempotencyKey:randomUUID()},prepared=await booking<{hash:string}>('staff_prepare_request',input),other=await booking('staff_confirm_request',{...input,calendarCheck:companyProof(prepared.hash)});const otherHash=await tableHash(db,'lk_live_booking_confirmed_segments','where t.booking_id=$1',[other.booking!.id]);await rpc('booking_cancel',args(f,1));const claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()}),lease=workerLease(claim);for(let i=0;i<2;i++)await rpc('cancel_worker_record',{...lease,...proof(claim,i)});await rpc('cancel_worker_finish',{...lease,finalProof:[proof(claim,0),proof(claim,1)]});assert.equal(await tableHash(db,'lk_live_booking_confirmed_segments','where t.booking_id=$1',[other.booking!.id]),otherHash);const document=await booking<{pdfHash:string}>('customer_document',{...f.customerArgs,kind:'confirmation'});assert.equal(document.pdfHash,fixtureHash('%PDF-frozen'))})
test('staff lists restore saved draft projection while authenticated customer state excludes staff-only draft and cancellation actor details',async()=>{const f=await seed();await rpc('booking_save',{...args(f),takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:'PRIVATE-STAFF-DRAFT'});const staff=await booking<LiveCompanyBookingState[]>('staff_list',f.staffArgs);assert.equal(staff[0].simpleDraft!.companyNote,'PRIVATE-STAFF-DRAFT');const customer=await booking('customer_state',f.customerArgs);assert.equal(customer.simpleDraft,null);assert.equal(JSON.stringify(customer).includes('PRIVATE-STAFF-DRAFT'),false)})
test('Calendar target changed before claim becomes durable review and blocks evidence/release without orphan lease',async()=>{const f=await seed();await verified(f);await rpc('booking_cancel',args(f,1));await db.exec('reset role');await db.exec("update public.lk_google_connection set account_sub='changed-account'");await db.exec('set role service_role');const result=await rpc<{reviewRequired:boolean;cancellation:{status:string;errorCode:string;occupancyHeld:boolean}}>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()});assert.equal(result.reviewRequired,true);assert.equal(result.cancellation.status,'review_required');assert.equal(result.cancellation.errorCode,'calendar_target_changed');assert.equal(result.cancellation.occupancyHeld,true);assert.equal(await rpc('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()}),null);const row=(await db.query<{lease_token:string|null;lease_expires_at:string|null}>('select lease_token,lease_expires_at from public.lk_live_company_cancellations where request_id=$1',[f.requestId])).rows[0];assert.equal(row.lease_token,null);assert.equal(row.lease_expires_at,null);assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments')).rows[0].n,2)})
test('Calendar target changed after claim is atomically persisted by error/assert/record/finish while fencing every external proof',async()=>{for(const command of ['cancel_worker_error','cancel_worker_assert','cancel_worker_record','cancel_worker_finish']){await resetCurrentWork(db);const f=await seed();await verified(f);await rpc('booking_cancel',args(f,1));const claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()}),lease=workerLease(claim);await db.exec('reset role');await db.exec("update public.lk_google_connection set account_sub='changed-account'");await db.exec('set role service_role');const result=await rpc<{reviewRequired:boolean;cancellation:{status:string;errorCode:string}}>(command,{...lease,...proof(claim,0),status:'retrying',errorCode:'calendar_outcome_unknown',finalProof:[proof(claim,0),proof(claim,1)]});assert.equal(result.reviewRequired,true);assert.equal(result.cancellation.status,'review_required');assert.equal(result.cancellation.errorCode,'calendar_target_changed');assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments')).rows[0].n,2);await assert.rejects(rpc('cancel_worker_record',{...lease,...proof(claim,0)}),fail('LK409'));const history=(await db.query<{details:{errorCode:string}}>("select details from public.lk_current_work_audit where action='cancel_worker_target_changed'")).rows;assert.equal(history.at(-1)!.details.errorCode,'calendar_target_changed')}})
test('immutable error audit keeps the previous failure code after a fresh claim clears current error_code',async()=>{const f=await seed();await verified(f);await rpc('booking_cancel',args(f,1));const claim=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()});await rpc('cancel_worker_error',{...workerLease(claim),status:'retrying',errorCode:'calendar_outcome_unknown'});const again=await rpc<CancellationClaim>('cancel_worker_claim',{requestId:f.requestId,leaseToken:randomUUID()});assert.equal(again.cancellation.errorCode,null);const rows=(await db.query<{details:{errorCode:string}}>("select details from public.lk_current_work_audit where action='cancel_worker_error'")).rows;assert.equal(rows.length,1);assert.equal(rows[0].details.errorCode,'calendar_outcome_unknown')})
test('accepted revision cancellation crosses staff API, real DB leases and fake Google absence proofs to release both holds',async()=>{
 const {createSimpleBookingManagementApi}=await import('./infrastructure/simple-management-api.ts'),{processSimpleBookingCancellation}=await import('./simple-cancellation.ts'),{removeSimpleBookingEvents}=await import('./live-calendar.ts')
 const f=await seedCompanyFixture(db,{simple:true,pricingVersion:'lk-sydney-cabinet-v3-20261014'}),contact={...f.snapshot.payload.contact};Reflect.deleteProperty(contact,'consent')
 const revision=<T>(command:string,args:Record<string,unknown>)=>db.query<{result:T}>('select public.lk_quote_company_revision_command($1,$2::jsonb) result',[command,JSON.stringify({companyId:'lk-group',...args})]).then(result=>result.rows[0].result)
 const saved=await revision<{receipt:{childId:string}}>('revision_save',{...f.staffArgs,expectedRevision:0,idempotencyKey:randomUUID(),reason:'Reviewed revision',payload:{contact,quantities:{doorCount:20,drawerCount:0,moderateRepair:false},extraItems:[],customerNote:''}})
 const publish={...f.staffArgs,revisionId:saved.receipt.childId,expectedRevision:1,idempotencyKey:randomUUID(),reason:'Publish reviewed revision'},prepared=await revision<{snapshotHash:string}>('revision_prepare_publish',publish),pdfBase64=Buffer.from('%PDF revision fixture').toString('base64'),frozenMail={pdfBase64,pdfHash:fixtureHash('%PDF revision fixture'),payload:{to:[f.email],subject:'Synthetic revision',attachments:[{filename:'revision.pdf',content:pdfBase64}]}}
 await revision('revision_publish',{...publish,snapshotHash:prepared.snapshotHash,frozenMail})
 await revision('customer_accept',{...f.customerArgs,revisionId:saved.receipt.childId,expectedRevision:2,idempotencyKey:randomUUID(),snapshotHash:prepared.snapshotHash,proofExpiresAt:new Date(Date.now()+600000).toISOString(),acknowledgmentVersion:'company-quote-revision-ack-v1',acknowledged:true,signature:f.signature,frozenMail})
 await verified(f);const state=await booking('staff_state',f.staffArgs);assert.equal(state.booking!.confirmationBasis,'accepted_revision')
 const sourceHash=await tableHash(db,'lk_live_quote_submissions'),events=new Map<string,Record<string,unknown>>();for(let index=0;index<2;index++){const plan=liveCompanyEventPlan({booking:state.booking!,proposal:state.proposal!,reference:state.submission.reference},index);events.set(plan.payload.id,{...plan.payload,etag:`"verified-${index}"`})}
 const store={command:<T>(name:string,input:Record<string,unknown>)=>rpc<T>(name,input)},api=createSimpleBookingManagementApi({store,authorize:async()=>({companyId:'lk-group',userId:f.staffId,sessionId:f.staffSessionId}),baseUrl:()=> 'https://example.invalid'})
 const response=await api.cancel(new Request('https://example.invalid/api/admin/live-bookings/'+f.requestId+'/cancel',{method:'POST',headers:{origin:'https://example.invalid','content-type':'application/json'},body:JSON.stringify({expectedRevision:state.revision,idempotencyKey:randomUUID(),reason:'Customer requested cancellation'})}),f.requestId);assert.equal(response.status,202)
 let deleted=0;const result=await processSimpleBookingCancellation(f.requestId,{store,enabled:()=>true,now:Date.now,remove:(claim,callbacks)=>removeSimpleBookingEvents(claim,callbacks,{target:async()=>state.proposal!.calendarTarget,now:()=>new Date(),occupancy:async()=>({segments:[]}),request:async(url,init)=>{const id=new URL(url).pathname.split('/').at(-1)!;if(init?.method==='DELETE'){assert.equal(new Headers(init.headers).get('If-Match'),events.get(id)?.etag);events.delete(id);deleted++;return new Response(null,{status:204})}return events.has(id)?Response.json(events.get(id)):new Response(null,{status:404})}})})
 assert.equal(result.cancelled,1);assert.equal(result.reviewRequired,0);assert.equal(deleted,2);assert.equal((await booking('staff_state',f.staffArgs)).booking!.status,'cancelled');assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments')).rows[0].n,0);assert.equal(await tableHash(db,'lk_live_quote_submissions'),sourceHash)
})
