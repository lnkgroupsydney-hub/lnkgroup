import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {companyClaim,companyTestNow} from './live-test-data.mts'
import {liveCompanyEventPlan,removeSimpleBookingEvents,type CompanyCalendarPorts} from './live-calendar.ts'
import {processSimpleBookingCancellation} from './simple-cancellation.ts'
import type {CancellationClaim,AbsenceProof} from './domain/simple-management.ts'
import type {LiveCompanyBookingState} from './domain/live-contracts.ts'
function harness(){const original=companyClaim(),booking=original.booking!;booking.confirmationBasis='signed_request';booking.signedSubmissionId=original.submission.id;booking.status='cancel_pending';original.proposal.confirmationBasis='signed_request';const events=new Map<string,Record<string,unknown>>(),calls:{url:string;init?:RequestInit}[]=[],records:AbsenceProof[]=[];const state={requestId:original.requestId,revision:2,submission:original.submission,proposal:original.proposal,proposals:[original.proposal],acceptance:null,booking,acknowledgment:{version:'',text:''}} as LiveCompanyBookingState;const owned={booking,proposal:original.proposal,reference:original.submission.reference};const manifest=original.proposal.segments.map((_,i)=>{const plan=liveCompanyEventPlan(owned,i);events.set(plan.payload.id,{...plan.payload,etag:'"original-'+i+'"'});return{segmentIndex:i,eventId:plan.payload.id,payloadHash:plan.payloadHash,etag:'"original-'+i+'"',verifiedAt:new Date(companyTestNow).toISOString()}});booking.events=manifest;const claim={id:randomUUID(),requestId:original.requestId,bookingId:booking.id,proposalHash:original.proposal.hash,leaseToken:randomUUID(),leaseExpiresAt:new Date(companyTestNow+240000).toISOString(),manifest,state,cancellation:{id:randomUUID(),requestId:original.requestId,bookingId:booking.id,status:'processing',requestedAt:new Date(companyTestNow).toISOString(),requestedBy:randomUUID(),cancelledAt:null,errorCode:null,occupancyHeld:true,totalEvents:2,verifiedDeletedEvents:0}} as CancellationClaim;const deps:CompanyCalendarPorts={target:async()=>original.proposal.calendarTarget,now:()=>new Date(companyTestNow),occupancy:async()=>({segments:[]}),request:async(url,init)=>{calls.push({url,init});const id=new URL(url).pathname.split('/').at(-1)!;if(init?.method==='DELETE'){assert.equal(init.body,undefined);assert.equal(new Headers(init.headers).get('if-match'),events.get(id)?.etag);assert.equal(new URL(url).searchParams.get('sendUpdates'),'none');events.delete(id);return new Response(null,{status:204})}return events.has(id)?Response.json(events.get(id)):new Response(null,{status:404})}};let leaseChecks=0;const callbacks={assertLease:async()=>{leaseChecks++},recordEvent:async(p:AbsenceProof)=>{records.push(p)}};return{claim,events,calls,records,deps,callbacks,leaseChecks:()=>leaseChecks}}
const review=(e:unknown)=>e instanceof Error&&'code'in e&&e.code==='company_calendar_review_required'
test('conditional deletion independently proves both exact event absences then reads them again before finalize',async()=>{const h=harness(),unrelated={id:'foreign',summary:'Leave this alone'};h.events.set('foreign',unrelated);const proof=await removeSimpleBookingEvents(h.claim,h.callbacks,h.deps);assert.equal(proof.length,2);assert.equal(h.records.length,2);assert.equal(h.calls.filter(c=>c.init?.method==='DELETE').length,2);assert.equal(h.calls.filter(c=>c.init?.method!=='DELETE').length,6);assert.deepEqual(h.events.get('foreign'),unrelated);assert.ok(h.leaseChecks()>6)})
test('lost DELETE response is recovered by exact GET without duplicate creation or foreign deletion',async()=>{const h=harness(),request=h.deps.request;h.deps.request=async(url,init)=>{const result=await request(url,init);if(init?.method==='DELETE')throw new Error('response lost after applied');return result};assert.equal((await removeSimpleBookingEvents(h.claim,h.callbacks,h.deps)).length,2);assert.equal(h.calls.some(c=>c.init?.method==='POST'),false)})
test('ownership, target, ETag, interval and 412 changes require review without pretending absence',async()=>{for(const mode of ['owner','etag','interval','target','412']){const h=harness(),first=h.events.get(h.claim.manifest[0].eventId)!;if(mode==='owner')first.extendedProperties={private:{bookingId:'foreign'}};if(mode==='etag')first.etag='"external"';if(mode==='interval')first.start={date:'2026-10-19'};if(mode==='target')h.deps.target=async()=>({accountSub:'changed',calendarId:'changed'});if(mode==='412'){const request=h.deps.request;h.deps.request=(url,init)=>init?.method==='DELETE'?Promise.resolve(new Response(null,{status:412})):request(url,init)}await assert.rejects(removeSimpleBookingEvents(h.claim,h.callbacks,h.deps),review);assert.equal(h.records.length,0);assert.equal(h.events.size,2)}})
test('partial second-event failure never produces final proof and first absence is safe for same-ID retry',async()=>{const h=harness(),request=h.deps.request,second=h.claim.manifest[1].eventId;h.deps.request=async(url,init)=>url.includes(second)?new Response(null,{status:503}):request(url,init);await assert.rejects(removeSimpleBookingEvents(h.claim,h.callbacks,h.deps));assert.equal(h.records.length,1);assert.equal(h.events.size,1);h.deps.request=request;assert.equal((await removeSimpleBookingEvents(h.claim,h.callbacks,h.deps)).length,2)})
test('lease loss, incomplete manifest and event reappearance block completion; cancelled tombstones are independent absence',async()=>{const h=harness();h.callbacks.assertLease=async()=>{throw Error('lease lost')};await assert.rejects(removeSimpleBookingEvents(h.claim,h.callbacks,h.deps));assert.equal(h.calls.length,0);const bad=harness();bad.claim.manifest[0].payloadHash='f'.repeat(64);await assert.rejects(removeSimpleBookingEvents(bad.claim,bad.callbacks,bad.deps),review);const re=harness();re.callbacks.recordEvent=async p=>{re.records.push(p);if(p.segmentIndex===1)re.events.set(re.claim.manifest[0].eventId,{id:re.claim.manifest[0].eventId,status:'confirmed'})};await assert.rejects(removeSimpleBookingEvents(re.claim,re.callbacks,re.deps),review);const tomb=harness();for(const [id]of tomb.events)tomb.events.set(id,{id,status:'cancelled'});assert.equal((await removeSimpleBookingEvents(tomb.claim,tomb.callbacks,tomb.deps)).every(p=>p.resultCode==='cancelled_tombstone'),true);assert.equal(tomb.calls.some(c=>c.init?.method==='DELETE'),false)})
test('durable processor uses same fenced identity, retries unknown storage and preserves review failures',async()=>{for(const mode of ['success','partial','review']){const h=harness(),calls:{name:string;args:Record<string,unknown>}[]=[];const result=await processSimpleBookingCancellation(h.claim.requestId,{enabled:()=>true,now:()=>companyTestNow,store:{command:async<T>(name:string,args:Record<string,unknown>)=>{calls.push({name,args});if(name==='cancel_worker_claim'){h.claim.leaseToken=String(args.leaseToken);return h.claim as T}return h.claim as T}},remove:async(claim,callbacks)=>{await callbacks.assertLease();await callbacks.recordEvent({segmentIndex:0,eventId:claim.manifest[0].eventId,resultCode:'absent_404',verifiedAt:new Date(companyTestNow).toISOString()});if(mode==='partial')throw Error('provider unknown');if(mode==='review')throw Object.assign(Error('external change'),{code:'company_calendar_review_required'});return[]}});assert.equal(result.claimed,1);assert.equal(result.cancelled,mode==='success'?1:0);if(mode!=='success'){assert.equal(calls.at(-1)!.name,'cancel_worker_error');assert.equal(calls.at(-1)!.args.status,mode==='review'?'review_required':'retrying')}for(const call of calls.slice(1)){assert.equal(call.args.bookingId,h.claim.bookingId);assert.equal(call.args.leaseToken,h.claim.leaseToken)}}})
test('DELETE authorization/quota failures retain occupancy even if a later read could hide the event',async()=>{for(const status of [401,403,429]){const h=harness(),request=h.deps.request;h.deps.request=(url,init)=>init?.method==='DELETE'?Promise.resolve(new Response(null,{status})):request(url,init);await assert.rejects(removeSimpleBookingEvents(h.claim,h.callbacks,h.deps));assert.equal(h.records.length,0)}})
test('DB-recorded target drift ends claim/assert/record/finalize as review without any release fallback or error rewrite',async()=>{for(const stage of ['cancel_worker_claim','cancel_worker_assert','cancel_worker_record','cancel_worker_finish','cancel_worker_error']){const h=harness(),calls:string[]=[];const result=await processSimpleBookingCancellation(h.claim.requestId,{enabled:()=>true,now:()=>companyTestNow,store:{command:async<T>(name:string,args:Record<string,unknown>)=>{calls.push(name);if(name===stage)return{reviewRequired:true,cancellation:{...h.claim.cancellation,status:'review_required',errorCode:'calendar_target_changed'}} as T;if(name==='cancel_worker_claim'){h.claim.leaseToken=String(args.leaseToken);return h.claim as T}return h.claim as T}},remove:async(claim,callbacks)=>{await callbacks.assertLease();await callbacks.recordEvent({segmentIndex:0,eventId:claim.manifest[0].eventId,resultCode:'absent_404',verifiedAt:new Date(companyTestNow).toISOString()});if(stage==='cancel_worker_error')throw Error('provider unavailable while target changed');return[]}});assert.equal(result.reviewRequired,1);assert.equal(result.cancelled,0);assert.equal(result.retrying,0);assert.equal(result.storageErrors,0);if(stage!=='cancel_worker_finish')assert.equal(calls.includes('cancel_worker_finish'),false);if(stage!=='cancel_worker_error')assert.equal(calls.includes('cancel_worker_error'),false)}})

test('accepted revision cancellation uses the same fenced manifest and independently proves both absences',async()=>{const h=harness(),evidence={companyRevisionId:randomUUID(),companyRevisionAcceptanceId:randomUUID(),companyRevisionSnapshotHash:'a'.repeat(64),companyRevisionSignedContentHash:'b'.repeat(64)};Object.assign(h.claim.state.booking!,{confirmationBasis:'accepted_revision',...evidence});Object.assign(h.claim.state.proposal!,{confirmationBasis:'accepted_revision',...evidence});h.events.clear();h.claim.manifest=h.claim.state.proposal!.segments.map((_,index)=>{const plan=liveCompanyEventPlan({booking:h.claim.state.booking!,proposal:h.claim.state.proposal!,reference:h.claim.state.submission.reference},index),etag=`\"original-${index}\"`;h.events.set(plan.payload.id,{...plan.payload,etag});return {segmentIndex:index,eventId:plan.payload.id,payloadHash:plan.payloadHash,etag,verifiedAt:new Date(companyTestNow).toISOString()}});h.claim.state.booking!.events=h.claim.manifest;const commands:string[]=[];const result=await processSimpleBookingCancellation(h.claim.requestId,{enabled:()=>true,now:()=>companyTestNow,remove:(claim,callbacks)=>removeSimpleBookingEvents(claim,callbacks,h.deps),store:{command:async<T>(name,args)=>{commands.push(name);if(name==='cancel_worker_claim'){h.claim.leaseToken=String(args.leaseToken);return h.claim as T}assert.equal(args.leaseToken,h.claim.leaseToken);if(name==='cancel_worker_finish'){assert.equal((args.finalProof as AbsenceProof[]).length,2);h.claim.state.booking!.status='cancelled';h.claim.cancellation.status='cancelled'}return h.claim as T}}});assert.equal(result.cancelled,1);assert.equal(result.reviewRequired,0);assert.equal(h.calls.filter(call=>call.init?.method==='DELETE').length,2);assert.equal(h.claim.state.booking!.status,'cancelled');assert.ok(commands.includes('cancel_worker_finish'));const forged=harness();Object.assign(forged.claim.state.booking!,{confirmationBasis:'accepted_revision',...evidence});Object.assign(forged.claim.state.proposal!,{confirmationBasis:'accepted_revision',...evidence,companyRevisionSignedContentHash:'c'.repeat(64)});await assert.rejects(removeSimpleBookingEvents(forged.claim,forged.callbacks,forged.deps),review);assert.equal(forged.calls.length,0)})
