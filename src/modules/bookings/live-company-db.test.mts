import test,{after,beforeEach} from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {readFileSync,readdirSync} from 'node:fs'
import {PGlite} from '@electric-sql/pglite'
import {companyRpc,initializeCompanyFixtureAuth,seedCompanyFixture,companyTarget,companyProof,fixtureHash} from './infrastructure/live-test-fixtures.mts'
import type {LiveCompanyBookingState,LiveCompanyWorkerClaim} from './domain/live-contracts.ts'
const db=new PGlite();await db.exec('create role anon;create role authenticated;create role service_role bypassrls;')
for(const f of readdirSync(new URL('../../../supabase/migrations/',import.meta.url)).filter(f=>f.endsWith('.sql')).sort())await db.exec(readFileSync(new URL('../../../supabase/migrations/'+f,import.meta.url),'utf8'))
await initializeCompanyFixtureAuth(db)
const tables=(await db.query<{tablename:string}>("select tablename from pg_tables where schemaname='public' and tablename like 'lk_%'")).rows.map(r=>'public.'+r.tablename)
beforeEach(async()=>{await db.exec('reset role');await db.exec(`truncate ${tables.join(',')},auth.users,auth.sessions`)});after(()=>db.close())
const failure=(code:string)=>(e:unknown)=>!!e&&typeof e==='object'&&'code'in e&&e.code===code
const rpc=<T=LiveCompanyBookingState>(cmd:string,args:Record<string,unknown>)=>companyRpc<T>(db,cmd,args)
const periods=[{kind:'all_day',startDate:'2030-01-05',endDate:'2030-01-07',startAt:'2030-01-04T13:00:00.000Z',endAt:'2030-01-06T13:00:00.000Z'},{kind:'timed',startDate:'2030-01-09',endDate:'2030-01-10',startAt:'2030-01-08T22:00:00.000Z',endAt:'2030-01-09T02:00:00.000Z',startLocal:'2030-01-09T09:00',endLocal:'2030-01-09T13:00'}]
const proposal={amountExGst:180001,scope:'Paint existing cabinet doors and drawer fronts.',adjustmentReason:'Site reviewed repair scope.',segments:periods}
async function draft(f:Awaited<ReturnType<typeof seedCompanyFixture>>,expectedRevision=0){return rpc('staff_draft',{...f.staffArgs,expectedRevision,idempotencyKey:randomUUID(),proposal,calendarTarget:companyTarget})}
async function published(f:Awaited<ReturnType<typeof seedCompanyFixture>>){const d=await draft(f);return rpc('staff_publish',{...f.staffArgs,expectedRevision:d.revision,proposalId:d.proposal!.id,proposalHash:d.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:companyProof(d.proposal!.hash)})}
async function accepted(f:Awaited<ReturnType<typeof seedCompanyFixture>>){const p=await published(f);return rpc('customer_accept',{...f.customerArgs,proposalId:p.proposal!.id,proposalHash:p.proposal!.hash,reviewExpiresAt:new Date(Date.now()+900000).toISOString(),signature:f.signature,idempotencyKey:randomUUID()})}
async function emailAccepted(kind:string,requestId:string){const outboxId=(await db.query<{id:string}>('select id from public.lk_live_company_outbox where request_id=$1 and kind=$2',[requestId,kind])).rows[0].id,leaseToken=randomUUID(),claim=await rpc<LiveCompanyWorkerClaim>('worker_claim',{requestId,outboxId,leaseToken});assert.equal(claim.kind,kind);const bytes=Buffer.from('%PDF-synthetic');await rpc('freeze_mail',{id:claim.id,leaseToken,pdfBase64:bytes.toString('base64'),pdfHash:fixtureHash(bytes.toString()),payload:{to:[claim.submission.snapshot.verifiedEmail],subject:'Synthetic notice'}});await rpc('email_attempt',{id:claim.id,leaseToken});await rpc('mail_result',{id:claim.id,leaseToken,providerMessageId:randomUUID()});return claim}
async function ready(f:Awaited<ReturnType<typeof seedCompanyFixture>>){const state=await accepted(f);await emailAccepted('proposal_notice',f.requestId);await emailAccepted('acceptance_receipt',f.requestId);return state}
async function confirm(f:Awaited<ReturnType<typeof seedCompanyFixture>>,state:LiveCompanyBookingState){return rpc('staff_confirm',{...f.staffArgs,expectedRevision:state.revision,proposalId:state.proposal!.id,proposalHash:state.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:companyProof(state.proposal!.hash)})}
test('company tables and command/helper predicates are private',async()=>{for(const role of ['anon','authenticated']){await db.exec('set role '+role);await assert.rejects(rpc('staff_list',{}),failure('42501'));await assert.rejects(db.query('select * from public.lk_live_company_proposals'),failure('42501'));await assert.rejects(db.query('select public.lk_live_company_ack()'),failure('42501'))}})
test('fresh staff membership, upstream session and email proof are transaction requirements',async()=>{const f=await seedCompanyFixture(db);assert.equal((await rpc('staff_state',f.staffArgs)).revision,0);await db.exec('reset role');await db.query("update auth.users set raw_app_meta_data=jsonb_set(raw_app_meta_data,'{lk_staff,status}','\"revoked\"') where id=$1",[f.staffId]);await db.exec('set role service_role');await assert.rejects(draft(f),failure('LK403'))})
test('revoked upstream customer identity cannot accept even with an original owner capability',async()=>{const f=await seedCompanyFixture(db);const p=await published(f);await db.exec('reset role');await db.query('delete from auth.sessions where id=$1',[f.authSessionId]);await db.exec('set role service_role');await assert.rejects(rpc('customer_review',{...f.customerArgs,proposalId:p.proposal!.id,proposalHash:p.proposal!.hash}),failure('LK401'))})
test('draft final cents and GST round on server; customer drafts hidden and original snapshot retained',async()=>{const f=await seedCompanyFixture(db),before=f.snapshot,state=await draft(f);assert.equal(state.proposal!.gst,18000);assert.equal(state.proposal!.total,198001);assert.equal((await rpc('customer_state',f.customerArgs)).proposal,null);assert.deepEqual(state.submission.snapshot,before);assert.equal(state.proposal!.status,'draft');assert.equal(state.revision,1)})
test('draft rejects stale revisions, unsupported Calendar and internally overlapping periods',async()=>{const f=await seedCompanyFixture(db);await draft(f);for(const bad of [{expectedRevision:0,proposal},{expectedRevision:1,proposal:{...proposal,segments:[periods[0],periods[0]]}},{expectedRevision:1,proposal,calendarTarget:{...companyTarget,calendarId:'legacy-test'}}])await assert.rejects(rpc('staff_draft',{...f.staffArgs,expectedRevision:1,idempotencyKey:randomUUID(),proposal,calendarTarget:companyTarget,...bad}),failure(bad.expectedRevision===0?'LK409':bad.calendarTarget?'LK409':'LK400'))})
test('published proposal is immutable, stale Google proof fails, new drafts invalidate old acceptance',async()=>{const f=await seedCompanyFixture(db),d=await draft(f);await assert.rejects(rpc('staff_publish',{...f.staffArgs,expectedRevision:1,proposalId:d.proposal!.id,proposalHash:d.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:{...companyProof(d.proposal!.hash),conflicts:[{}]}}),failure('LK409'));const p=await rpc('staff_publish',{...f.staffArgs,expectedRevision:1,proposalId:d.proposal!.id,proposalHash:d.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:companyProof(d.proposal!.hash)});await db.exec('reset role');await assert.rejects(db.query("update public.lk_live_company_proposals set snapshot=snapshot||'{\"forged\":1}' where id=$1",[p.proposal!.id]),failure('LK409'));await db.exec('set role service_role');await draft(f,2);await assert.rejects(rpc('customer_accept',{...f.customerArgs,proposalId:p.proposal!.id,proposalHash:p.proposal!.hash,reviewExpiresAt:new Date(Date.now()+900000).toISOString(),signature:f.signature,idempotencyKey:randomUUID()}),failure('LK409'))})
test('exact customer acknowledgment replay binds signature/hash and cannot be borrowed by another identity',async()=>{const f=await seedCompanyFixture(db),p=await published(f),key=randomUUID(),args={...f.customerArgs,proposalId:p.proposal!.id,proposalHash:p.proposal!.hash,reviewExpiresAt:new Date(Date.now()+900000).toISOString(),signature:f.signature,idempotencyKey:key};const a=await rpc('customer_accept',args);assert.ok(a.acceptance);assert.equal((await rpc('customer_accept',{...args,reviewExpiresAt:new Date(Date.now()-1000).toISOString()})).acceptance!.id,a.acceptance!.id);await assert.rejects(rpc('customer_accept',{...args,signature:{...f.signature,name:'Another customer'}}),failure('LK409'));const other=await seedCompanyFixture(db,{email:'bob@example.invalid'});await assert.rejects(rpc('customer_accept',{...args,customerAccess:{...other.customerArgs.customerAccess,requestId:f.requestId}}),failure('LK404'))})
test('confirmation waits for the exact acceptance receipt provider outcome, then holds all periods atomically',async()=>{const f=await seedCompanyFixture(db),a=await accepted(f);await assert.rejects(confirm(f,a),failure('LK409'));await emailAccepted('proposal_notice',f.requestId);await emailAccepted('acceptance_receipt',f.requestId);const b=await confirm(f,a);assert.equal(b.booking!.status,'confirming');assert.equal(b.booking!.events.length,2);const occupancy=await rpc<{segments:{startAt:string}[]}>('occupancy',companyTarget);assert.equal(occupancy.segments.length,2);assert.equal((await rpc('staff_state',f.staffArgs)).booking!.id,b.booking!.id);await assert.rejects(draft(f,b.revision),failure('LK409'))})
test('mixed all-day and timed overlap is excluded; one conflicting later segment rolls back all periods',async()=>{const a=await seedCompanyFixture(db),first=await ready(a);await confirm(a,first);const b=await seedCompanyFixture(db,{email:'bob@example.invalid'}),second=await ready(b);await assert.rejects(confirm(b,second),failure('LK409'));assert.equal((await rpc('staff_state',b.staffArgs)).booking,null);const rows=(await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments')).rows[0];assert.equal(rows.n,2)})
test('fenced worker events and fresh post-create conflict proof precede confirmed status and mail',async()=>{const f=await seedCompanyFixture(db),a=await ready(f),state=await confirm(f,a),leaseToken=randomUUID(),claim=await rpc<LiveCompanyWorkerClaim>('worker_claim',{requestId:f.requestId,leaseToken});assert.equal(claim.kind,'confirmation');const frozen={id:claim.id,leaseToken,pdfBase64:Buffer.from('%PDF-company').toString('base64'),pdfHash:fixtureHash('%PDF-company'),payload:{to:[f.email]}};await assert.rejects(rpc('freeze_mail',frozen),failure('LK409'));await assert.rejects(rpc('finish_calendar',{id:claim.id,leaseToken,calendarCheck:companyProof(state.proposal!.hash)}),failure('LK409'));for(const e of state.booking!.events){await assert.rejects(rpc('record_event',{id:claim.id,leaseToken:randomUUID(),...e,payloadHash:'a'.repeat(64),etag:'etag'}),failure('LK409'));await rpc('record_event',{id:claim.id,leaseToken,...e,payloadHash:'a'.repeat(64),etag:'etag'})}const finished=await rpc<LiveCompanyWorkerClaim>('finish_calendar',{id:claim.id,leaseToken,calendarCheck:companyProof(state.proposal!.hash)});assert.equal(finished.booking!.status,'confirmed');assert.ok(finished.booking!.confirmedAt);await rpc('freeze_mail',frozen);await rpc('email_attempt',{id:claim.id,leaseToken});await rpc('mail_result',{id:claim.id,leaseToken,providerMessageId:'accepted'});assert.equal((await rpc('staff_state',f.staffArgs)).booking!.emailStatus,'provider_accepted')})
test('review-required external changes preserve UTC/date holds and never silently restore confirmed',async()=>{const f=await seedCompanyFixture(db),state=await confirm(f,await ready(f));const reviewed=await rpc('reconcile_result',{bookingId:state.booking!.id,ok:false,error:'Google period moved'});assert.equal(reviewed.booking!.status,'review_required');assert.equal((await rpc<{segments:unknown[]}>('occupancy',companyTarget)).segments.length,2);assert.equal((await rpc('reconcile_result',{bookingId:state.booking!.id,ok:true})).booking!.status,'review_required')})
test('outbox lease recovery keeps the frozen bytes/key and ambiguous expired sends do not block later work',async()=>{const f=await seedCompanyFixture(db);await published(f);const leaseToken=randomUUID(),one=await rpc<LiveCompanyWorkerClaim>('worker_claim',{requestId:f.requestId,leaseToken});await db.exec('reset role');await db.query("update public.lk_live_company_outbox set lease_expires_at=now()-interval '1 second',email_first_attempt_at=now()-interval '25 hours',email_status='outcome_unknown' where id=$1",[one.id]);await db.exec('set role service_role');assert.equal(await rpc('worker_claim',{requestId:f.requestId,leaseToken:randomUUID()}),null);const other=await seedCompanyFixture(db,{email:'bob@example.invalid'});await published(other);assert.equal((await rpc<LiveCompanyWorkerClaim>('worker_claim',{leaseToken:randomUUID()})).requestId,other.requestId)})
test('confirmation email attempt is blocked if reconciliation requires review after PDF freeze',async()=>{
 const f=await seedCompanyFixture(db),state=await confirm(f,await ready(f)),leaseToken=randomUUID(),claim=await rpc<LiveCompanyWorkerClaim>('worker_claim',{requestId:f.requestId,leaseToken})
 for(const e of state.booking!.events)await rpc('record_event',{id:claim.id,leaseToken,...e,payloadHash:'a'.repeat(64),etag:'etag'})
 await rpc('finish_calendar',{id:claim.id,leaseToken,calendarCheck:companyProof(state.proposal!.hash)})
 await rpc('freeze_mail',{id:claim.id,leaseToken,pdfBase64:Buffer.from('%PDF-company').toString('base64'),pdfHash:fixtureHash('%PDF-company'),payload:{to:[f.email]}})
 await rpc('reconcile_result',{bookingId:state.booking!.id,ok:false,error:'External conflict appeared'})
 await assert.rejects(rpc('email_attempt',{id:claim.id,leaseToken}),failure('LK409'));await assert.rejects(rpc('assert_lease',{id:claim.id,leaseToken}),failure('LK409'))
 const row=(await db.query<{email_first_attempt_at:string|null}>('select email_first_attempt_at from public.lk_live_company_outbox where id=$1',[claim.id])).rows[0];assert.equal(row.email_first_attempt_at,null)
})
test('a later conflicting segment rolls back an earlier free segment and adjacent UTC boundaries are allowed',async()=>{
 const a=await seedCompanyFixture(db),first=await ready(a);await confirm(a,first)
 const b=await seedCompanyFixture(db,{email:'later@example.invalid'}),custom={...proposal,segments:[{...periods[0],startDate:'2030-01-07',endDate:'2030-01-08',startAt:'2030-01-06T13:00:00.000Z',endAt:'2030-01-07T13:00:00.000Z'},periods[1]]}
 const d=await rpc('staff_draft',{...b.staffArgs,expectedRevision:0,idempotencyKey:randomUUID(),proposal:custom,calendarTarget:companyTarget})
 const p=await rpc('staff_publish',{...b.staffArgs,expectedRevision:d.revision,proposalId:d.proposal!.id,proposalHash:d.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:companyProof(d.proposal!.hash)})
 const acceptedState=await rpc('customer_accept',{...b.customerArgs,proposalId:p.proposal!.id,proposalHash:p.proposal!.hash,reviewExpiresAt:new Date(Date.now()+900000).toISOString(),signature:b.signature,idempotencyKey:randomUUID()});await emailAccepted('proposal_notice',b.requestId);await emailAccepted('acceptance_receipt',b.requestId)
 await assert.rejects(confirm(b,acceptedState),failure('LK409'));assert.equal((await rpc('staff_state',b.staffArgs)).booking,null)
 assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_live_booking_confirmed_segments where submission_id=$1',[b.submissionId])).rows[0].n,0)
 const c=await seedCompanyFixture(db,{email:'adjacent@example.invalid'}),adjacent={...proposal,segments:[custom.segments[0]]}
 const cd=await rpc('staff_draft',{...c.staffArgs,expectedRevision:0,idempotencyKey:randomUUID(),proposal:adjacent,calendarTarget:companyTarget}),cp=await rpc('staff_publish',{...c.staffArgs,expectedRevision:cd.revision,proposalId:cd.proposal!.id,proposalHash:cd.proposal!.hash,idempotencyKey:randomUUID(),calendarCheck:companyProof(cd.proposal!.hash)}),ca=await rpc('customer_accept',{...c.customerArgs,proposalId:cp.proposal!.id,proposalHash:cp.proposal!.hash,reviewExpiresAt:new Date(Date.now()+900000).toISOString(),signature:c.signature,idempotencyKey:randomUUID()});await emailAccepted('proposal_notice',c.requestId);await emailAccepted('acceptance_receipt',c.requestId);assert.equal((await confirm(c,ca)).booking!.status,'confirming')
})
test('partial timed occupancy blocks the entire Sydney day at existing customer date/save boundaries',async()=>{
 const a=await seedCompanyFixture(db);await confirm(a,await ready(a));const projected=(await db.query<{start_date:string;end_date:string}>('select start_date::text,end_date::text from public.lk_live_booking_confirmed_segments order by start_at')).rows
 assert.deepEqual(projected,[{start_date:'2030-01-05',end_date:'2030-01-07'},{start_date:'2030-01-09',end_date:'2030-01-10'}])
 const old=(await db.query<{value:{segments:{startDate:string;endDate:string}[]}}>("select public.lk_live_quote_booking_command('occupancy',$1::jsonb) value",[JSON.stringify({companyId:'lk-group',...companyTarget})])).rows[0].value
 assert.equal(old.segments.some(s=>s.startDate<='2030-01-09'&&s.endDate>'2030-01-09'),true);assert.equal(old.segments.some(s=>s.startDate<='2030-01-08'&&s.endDate>'2030-01-08'),false)
})
test('bounded reconciliation batch includes upcoming confirmed/review holds and records checks without clearing review',async()=>{
 const f=await seedCompanyFixture(db),state=await confirm(f,await ready(f))
 assert.deepEqual((await rpc<{states:LiveCompanyBookingState[]}>('reconcile_batch',{})).states,[])
 const leaseToken=randomUUID(),claim=await rpc<LiveCompanyWorkerClaim>('worker_claim',{requestId:f.requestId,leaseToken});for(const e of state.booking!.events)await rpc('record_event',{id:claim.id,leaseToken,...e,payloadHash:'a'.repeat(64),etag:'etag'});await rpc('finish_calendar',{id:claim.id,leaseToken,calendarCheck:companyProof(state.proposal!.hash)})
 assert.equal((await rpc<{states:LiveCompanyBookingState[]}>('reconcile_batch',{})).states.length,1)
 await rpc('reconcile_result',{bookingId:state.booking!.id,ok:false,error:'Busy changed'});await rpc('reconcile_result',{bookingId:state.booking!.id,ok:true})
 const batch=await rpc<{states:LiveCompanyBookingState[]}>('reconcile_batch',{});assert.equal(batch.states[0].booking!.status,'review_required');assert.ok((await db.query<{last_calendar_check_at:string}>('select last_calendar_check_at from public.lk_live_company_bookings where id=$1',[state.booking!.id])).rows[0].last_calendar_check_at)
})
