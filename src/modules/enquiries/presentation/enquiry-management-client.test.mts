import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {CurrentWorkClient} from './enquiry-management-client.ts'
import {workObject} from '../management.ts'
import {simpleBookingActions} from '../../bookings/presentation/simple-booking-client.ts'
import type {SimpleBookingManagement} from '../../bookings/domain/simple-management.ts'
const id=randomUUID(),path=`/api/admin/enquiries/${id}/archive`,input={expectedRevision:0,reason:'Original reason',nested:{name:'Secret original'}}
const receipt=(key:string,entityType='enquiry')=>({receipt:{idempotencyKey:key,entityType,entityId:id,action:'enquiry_archive',revision:1,committedAt:new Date().toISOString()}})
function deferred<T>(){let resolve!:(value:T)=>void,reject!:(error:unknown)=>void;const promise=new Promise<T>((yes,no)=>{resolve=yes;reject=no});return{promise,resolve,reject}}
test('unknown result freezes deep-cloned body/key; status404 keeps original intent and retry uses exact request',async()=>{const bodies:string[]=[],key=randomUUID();let reads=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method){reads++;return new Response(null,{status:404})}bodies.push(String(init.body));if(bodies.length===1)throw Error('response lost');return Response.json(receipt(key))},()=>key);const mutable=structuredClone(input);assert.equal((await client.mutate(path,'POST',mutable)).phase,'unknown');mutable.nested.name='Changed afterwards';await assert.rejects(client.mutate(path,'POST',{...input,reason:'Different'}));assert.equal((await client.check(path+'/commands/'+key)).phase,'unknown');assert.equal(client.pendingRequest()!.body.idempotencyKey,key);assert.equal((await client.retry()).phase,'saved');assert.equal(bodies[0],bodies[1]);assert.equal(JSON.parse(bodies[1]).nested.name,'Secret original');assert.equal(reads,1)})
test('409 preserves editable input and revision metadata for explicit compare and resave',async()=>{const client=new CurrentWorkClient(workObject,async()=>Response.json({error:'Changed',code:'revision_conflict',outcome:'not_applied',currentRevision:4},{status:409}));const state=await client.mutate(path,'POST',input);assert.equal(state.phase,'conflict');assert.equal(state.input!.reason,input.reason);assert.equal(state.currentRevision,4);assert.equal(client.pendingRequest(),null)})
test('401/403 clear all sensitive state and pending payload, and late write/read 200 cannot restore it',async()=>{for(const status of [401,403]){const late=deferred<Response>();const key=randomUUID();let calls=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>{calls++;if(calls===1)return Response.json({secret:'Sensitive data'});if(init?.method)return late.promise;return new Response(null,{status})},()=>key);await client.read('/read');const writing=client.mutate(path,'POST',input);await client.read('/access-check');assert.equal(client.snapshot().phase,'access_lost');assert.equal(client.snapshot().data,null);assert.equal(client.snapshot().input,null);assert.equal(client.pendingRequest(),null);late.resolve(Response.json(receipt(key)));await writing;assert.equal(client.snapshot().phase,'access_lost')}})
test('confirmed status receipt invalidates a late rejected mutation response instead of leaving unknown with no pending body',async()=>{const late=deferred<Response>(),key=randomUUID();const client=new CurrentWorkClient(workObject,async(_url,init)=>init?.method?late.promise:Response.json(receipt(key)),()=>key);const writing=client.mutate(path,'POST',input);assert.equal((await client.check('/commands/'+key)).phase,'saved');late.reject(Error('late timeout'));await writing;assert.equal(client.snapshot().phase,'saved');assert.equal(client.pendingRequest(),null)})
test('newest read wins even if aborted old read resolves; malformed success receipt remains safely unknown',async()=>{const late=deferred<Response>();let reads=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>init?.method?Response.json(receipt(randomUUID())):++reads===1?late.promise:Response.json({secret:'New'}));const old=client.read('/old');await client.read('/new');late.resolve(Response.json({secret:'Old'}));await old;assert.equal(client.snapshot().data!.secret,'New');assert.equal((await client.mutate(path,'POST',input)).phase,'unknown');assert.ok(client.pendingRequest())})
test('accepted cancellation retry continues original command key without generating a new intent',async()=>{const key=randomUUID();let generated=0,body:Record<string,unknown>={};const client=new CurrentWorkClient<SimpleBookingManagement>(value=>value as SimpleBookingManagement,async(_url,init)=>{body=JSON.parse(String(init?.body));return Response.json(receipt(key,'simple_booking'))},()=>{generated++;return randomUUID()});await simpleBookingActions(client,id).retryCancellation(key);assert.deepEqual(body,{idempotencyKey:key});assert.equal(generated,0);assert.equal(client.snapshot().phase,'saved')})
test('late uncertain status404/rejection cannot overwrite a definite retry409/422 after pending is resolved',async()=>{for(const statusOutcome of ['404','reject'])for(const retryStatus of [409,422]){const late=deferred<Response>();let writes=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method)return late.promise;if(++writes===1)throw Error('original response lost');return Response.json({error:'Definite rejection',code:retryStatus===409?'revision_conflict':'validation',outcome:'not_applied'},{status:retryStatus})});await client.mutate(path,'POST',input);const checking=client.check('/commands/status');await client.retry();assert.equal(client.snapshot().phase,retryStatus===409?'conflict':'error');assert.equal(client.pendingRequest(),null);if(statusOutcome==='404')late.resolve(new Response(null,{status:404}));else late.reject(Error('late status read failed'));await checking;assert.equal(client.snapshot().phase,retryStatus===409?'conflict':'error');assert.equal(client.pendingRequest(),null);assert.equal(client.snapshot().input!.reason,input.reason)}})
test('public pure client default fetch keeps the browser receiver for read, mutate and command check',async()=>{const {CurrentWorkClient:PublicCurrentWorkClient}=await import('../management-client.ts'),original=globalThis.fetch,key=randomUUID();let writes=0,calls=0;globalThis.fetch=async function(this:unknown,_url,init){if(this!==globalThis)throw new TypeError('Illegal invocation');calls++;if(init?.method){if(++writes===1)throw Error('response lost after dispatch');return Response.json(receipt(key))}return String(_url).includes('/commands/')?Response.json(receipt(key)):Response.json({secret:'Current saved record'})};try{const client=new PublicCurrentWorkClient(workObject,undefined,()=>key);assert.equal((await client.read('/read')).data!.secret,'Current saved record');assert.equal((await client.mutate(path,'POST',input)).phase,'unknown');assert.equal((await client.check(`/commands/${key}`)).phase,'saved');assert.equal((await client.mutate(path,'POST',input)).phase,'saved');assert.equal(calls,4)}finally{globalThis.fetch=original}})
test('injected fetch is invoked as a function rather than as a CurrentWorkClient method',async()=>{const key=randomUUID();let called=false;const injected:typeof fetch=async function(this:unknown){assert.equal(this,undefined);called=true;return Response.json(receipt(key))};const client=new CurrentWorkClient(workObject,injected,()=>key);assert.equal((await client.mutate(path,'POST',input)).phase,'saved');assert.equal(called,true)})
test('first 503 not_applied is definite, retains input and data, and allows a new explicit intent with a new key',async()=>{const bodies:Record<string,unknown>[]=[],keys=[randomUUID(),randomUUID()];const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method)return Response.json({secret:'Loaded data'});const body=JSON.parse(String(init.body));bodies.push(body);return bodies.length===1?Response.json({error:'Changes paused',code:'unavailable',outcome:'not_applied'},{status:503}):Response.json(receipt(String(body.idempotencyKey)))},()=>keys[bodies.length]);await client.read('/read');const failed=await client.mutate(path,'POST',input);assert.equal(failed.phase,'error');assert.equal(failed.error,'Changes paused');assert.equal(failed.input!.reason,input.reason);assert.equal(failed.data!.secret,'Loaded data');assert.equal(failed.receipt,null);assert.equal(failed.currentRevision,undefined);assert.equal(failed.fields,null);assert.equal(client.pendingRequest(),null);await assert.rejects(client.retry());assert.equal((await client.mutate(path,'POST',{...input,reason:'Explicit next intent'})).phase,'saved');assert.equal(bodies.length,2);assert.notEqual(bodies[0].idempotencyKey,bodies[1].idempotencyKey)})
test('unknown then repeated retry503 not_applied keeps the original key/body and unknown guard until a receipt resolves it',async()=>{const key=randomUUID(),bodies:string[]=[];let writes=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method)return Response.json(receipt(key));bodies.push(String(init.body));if(++writes===1)throw Error('original response lost');return Response.json({error:'Current send was not applied',code:'unavailable',outcome:'not_applied'},{status:503})},()=>key);await client.mutate(path,'POST',input);const original=client.pendingRequest();for(let i=0;i<2;i++){const state=await client.retry();assert.equal(state.phase,'unknown');assert.equal(state.code,'unavailable');assert.match(state.error!,/previous save is still unconfirmed/i);assert.deepEqual(client.pendingRequest(),original);await assert.rejects(client.mutate(path,'POST',{...input,reason:'Forbidden new intent'}))}assert.equal(new Set(bodies).size,1);assert.equal((await client.check(`/commands/${key}`)).phase,'saved');assert.equal(client.pendingRequest(),null)})
test('an in-flight status receipt still resolves an unknown command after a definite503 retry and unknown history resets afterwards',async()=>{const key=randomUUID(),status=deferred<Response>();let writes=0;const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method)return status.promise;if(++writes===1)throw Error('lost');return Response.json({error:'Paused',code:'unavailable',outcome:'not_applied'},{status:503})},()=>key);await client.mutate(path,'POST',input);const checking=client.check(`/commands/${key}`);assert.equal((await client.retry()).phase,'unknown');status.resolve(Response.json(receipt(key)));assert.equal((await checking).phase,'saved');assert.equal((await client.mutate(path,'POST',input)).phase,'error');assert.equal(client.pendingRequest(),null)})
test('missing or invalid outcomes, other5xx, invalid JSON, transport failures and malformed success remain unknown',async()=>{const responses=[()=>Response.json({error:'Unknown',code:'unavailable',outcome:'unknown'},{status:503}),()=>Response.json({error:'No outcome',code:'unavailable'},{status:503}),()=>Response.json({error:'Invalid outcome',outcome:'maybe'},{status:409}),()=>Response.json({error:'Other5xx',outcome:'not_applied'},{status:500}),()=>new Response('not-json',{status:503}),()=>Response.json(null,{status:503}),()=>Response.json([],{status:422}),()=>Response.json({receipt:{}}),()=>{throw Error('transport failed')}];for(const response of responses){const client=new CurrentWorkClient(workObject,async()=>response());const state=await client.mutate(path,'POST',input);assert.equal(state.phase,'unknown');assert.ok(client.pendingRequest());assert.equal(state.fields,null);assert.equal(state.receipt,null);assert.equal(state.currentRevision,undefined)}})
function errorResponse(status:number,body:Record<string,unknown>){return {ok:false,status,json:async()=>body} as Response}
test('422 field errors expose only the current writable paths and keep editable input while resolving the pending command',async()=>{const client=new CurrentWorkClient(workObject,async()=>errorResponse(422,{error:'Correct these fields',code:'validation',outcome:'not_applied',fields:{'payload.contact.email':' Enter a valid email. ',body:'Enter a note.',price:'Forbidden',__proto__:'Forbidden',constructor:'Forbidden'},currentRevision:99}));const state=await client.mutate(path,'POST',input);assert.equal(state.phase,'error');assert.deepEqual(state.fields,{'payload.contact.email':'Enter a valid email.',body:'Enter a note.'});assert.equal(state.currentRevision,undefined);assert.equal(state.input!.reason,input.reason);assert.equal(client.pendingRequest(),null);assert.equal(({} as Record<string,unknown>).polluted,undefined)})
test('422 fields ignore unsafe containers, keys, inherited/accessor values, controls and size limits without executing getters',async()=>{let getterCalls=0;const accessor={};Object.defineProperty(accessor,'reason',{enumerable:true,get(){getterCalls++;return 'Must not read'}});const nonEnumerable={};Object.defineProperty(nonEnumerable,'reason',{value:'Hidden',enumerable:false});const inherited=Object.create({reason:'Inherited'});const nullPrototype=Object.assign(Object.create(null),{reason:'Valid null prototype'});const tooMany=Object.fromEntries(Array.from({length:33},(_,i)=>['unknown'+i,'value']));const aggregate=Object.fromEntries(['reason','body','assigneeUserId','companyNote','takeOffEndLocal','installStartLocal','installEndLocal','payload.contact.name','payload.contact.email'].map(k=>[k,'x'.repeat(500)]));const values=[null,[],0,'text',new Date(),accessor,nonEnumerable,inherited,tooMany,aggregate,{reason:''},{reason:' '},{reason:'x'.repeat(501)},{reason:'bad\nmessage'},{reason:'bad\u0085message'},{reason:42},{reason:{toString(){throw Error('Do not coerce')}}},JSON.parse('{"__proto__":{"polluted":true},"constructor":"bad","prototype":"bad"}')];for(const fields of values){const client=new CurrentWorkClient(workObject,async()=>errorResponse(422,{error:'Invalid input',code:'validation',outcome:'not_applied',fields}));const state=await client.mutate(path,'POST',input);assert.equal(state.phase,'error');assert.equal(state.fields,null);assert.equal(client.pendingRequest(),null)}const client=new CurrentWorkClient(workObject,async()=>errorResponse(422,{error:'Invalid input',code:'validation',outcome:'not_applied',fields:nullPrototype}));assert.deepEqual((await client.mutate(path,'POST',input)).fields,{reason:'Valid null prototype'});assert.equal(getterCalls,0);assert.equal(({} as Record<string,unknown>).polluted,undefined);const envelope={error:'Invalid input',code:'validation',outcome:'not_applied'};Object.defineProperty(envelope,'fields',{enumerable:true,get(){getterCalls++;throw Error('Do not read envelope getter')}});const safe=new CurrentWorkClient(workObject,async()=>errorResponse(422,envelope));assert.equal((await safe.mutate(path,'POST',input)).phase,'error');assert.equal(getterCalls,0)})
test('only explicit422 not_applied may expose fields and each new request clears stale receipt revision and field metadata',async()=>{const responses=[Response.json(receipt('replace-key')),errorResponse(409,{error:'Conflict',code:'revision_conflict',outcome:'not_applied',currentRevision:4,fields:{reason:'Wrong status'}}),errorResponse(422,{error:'Invalid',code:'validation',outcome:'not_applied',fields:{reason:'Current reason'},currentRevision:88}),errorResponse(503,{error:'Paused',code:'unavailable',outcome:'not_applied',fields:{reason:'Wrong status'}}),errorResponse(422,{error:'Uncertain',code:'validation',outcome:'unknown',fields:{reason:'Hidden'}})];let index=0;const key=randomUUID();responses[0]=Response.json(receipt(key));const client=new CurrentWorkClient(workObject,async()=>responses[index++],()=>key);assert.equal((await client.mutate(path,'POST',input)).receipt!.idempotencyKey,key);let state=await client.mutate(path,'POST',input);assert.equal(state.receipt,null);assert.equal(state.currentRevision,4);assert.equal(state.fields,null);state=await client.mutate(path,'POST',input);assert.equal(state.currentRevision,undefined);assert.deepEqual(state.fields,{reason:'Current reason'});state=await client.mutate(path,'POST',input);assert.equal(state.phase,'error');assert.equal(state.fields,null);assert.equal(state.receipt,null);assert.equal(state.currentRevision,undefined);state=await client.mutate(path,'POST',input);assert.equal(state.phase,'unknown');assert.equal(state.fields,null);client.clear();assert.equal(client.snapshot().fields,null);assert.equal(client.snapshot().input,null)})
test('ordinary detail reads preserve current field errors while retry success, continuation and clear remove them',async()=>{let mode='validation';const key=randomUUID();const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(!init?.method)return Response.json({secret:'Read data'});if(mode==='validation')return errorResponse(422,{error:'Invalid',code:'validation',outcome:'not_applied',fields:{reason:'Current message'}});if(mode==='unknown')throw Error('unknown');return Response.json(receipt(key))},()=>key);await client.mutate(path,'POST',input);assert.deepEqual((await client.read('/detail')).fields,{reason:'Current message'});mode='unknown';await client.mutate(path,'POST',input);assert.equal(client.snapshot().fields,null);mode='saved';assert.equal((await client.retry()).fields,null);assert.equal(client.snapshot().currentRevision,undefined);await client.continueCommand(path,{idempotencyKey:key});assert.equal(client.snapshot().input,null);assert.equal(client.snapshot().fields,null);client.clear();assert.equal(client.snapshot().receipt,null)})
test('access loss invalidates late422 fields, definite503, successful writes and status responses',async()=>{for(const lateStatus of [200,422,503])for(const denied of [401,403]){const late=deferred<Response>();let writes=0;const key=randomUUID();const client=new CurrentWorkClient(workObject,async(url,init)=>{if(String(url)==='/access')return new Response(null,{status:denied});if(init?.method){writes++;return late.promise}return late.promise},()=>key);const writing=client.mutate(path,'POST',input);await client.read('/access');late.resolve(lateStatus===200?Response.json(receipt(key)):errorResponse(lateStatus,{error:'Late failure',code:'validation',outcome:'not_applied',fields:{reason:'Must not restore'}}));await writing;assert.equal(writes,1);assert.equal(client.snapshot().phase,'access_lost');assert.equal(client.snapshot().fields,null);assert.equal(client.snapshot().receipt,null);assert.equal(client.snapshot().input,null);assert.equal(client.pendingRequest(),null)}const late=deferred<Response>(),key=randomUUID();const client=new CurrentWorkClient(workObject,async(url,init)=>String(url)==='/access'?new Response(null,{status:403}):init?.method?Promise.reject(Error('unknown')):late.promise,()=>key);await client.mutate(path,'POST',input);const checking=client.check(`/commands/${key}`);await client.read('/access');late.resolve(Response.json(receipt(key)));await checking;assert.equal(client.snapshot().phase,'access_lost');assert.equal(client.snapshot().fields,null);assert.equal(client.snapshot().receipt,null)})

test('detail read preserves HTTP status, resets it on success/clear and ignores stale failures',async()=>{
 let mode=404;const client=new CurrentWorkClient(workObject,async()=>mode===200?Response.json({secret:'Saved record'}):new Response('not-json',{status:mode}));
 assert.equal((await client.read('/missing')).status,404);mode=503;assert.equal((await client.read('/unavailable')).status,503);mode=200;assert.equal((await client.read('/success')).status,undefined);
 mode=403;const denied=await client.read('/denied');assert.equal(denied.status,403);assert.equal(denied.data,null);assert.equal(denied.phase,'access_lost');client.clear();assert.equal(client.snapshot().status,undefined);
 const old=deferred<Response>();const race=new CurrentWorkClient(workObject,async url=>String(url)==='/old'?old.promise:Response.json({secret:'New'}));const reading=race.read('/old');await race.read('/new');old.resolve(new Response(null,{status:404}));await reading;assert.equal(race.snapshot().status,undefined);assert.equal(race.snapshot().data!.secret,'New');
});
test('detail HTTP failure does not replace pending mutation outcome or input',async()=>{
 const client=new CurrentWorkClient(workObject,async(_url,init)=>{if(init?.method)throw Error('lost response');return new Response(null,{status:404})});await client.mutate(path,'POST',input);const pending=client.pendingRequest();const state=await client.read('/missing');assert.equal(state.phase,'unknown');assert.equal(state.status,undefined);assert.deepEqual(client.pendingRequest(),pending);assert.equal(state.input!.reason,input.reason);
});
