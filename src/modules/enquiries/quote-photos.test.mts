import test from 'node:test';
import assert from 'node:assert/strict';
import {createHash,randomUUID} from 'node:crypto';
import sharp from 'sharp';
import {normalizeQuotePhoto} from './infrastructure/quote-photo-image.ts';
import {quotePhotos,type PhotoRecord,type PhotoPorts} from './application/quote-photos.ts';
import {PHOTO_NOTICE_VERSION,PHOTO_PROCESSING_VERSION,QUOTE_PHOTO_LIMITS,validatePhotoReservation,validateQuotePhotoManifest,PhotoError} from './domain/quote-photos.ts';
import {receivePhotoBytes} from './infrastructure/quote-photo-api.ts';
const hash=(bytes:Uint8Array)=>createHash('sha256').update(bytes).digest('hex');
const rejects=(status:number)=>(e:unknown)=>e instanceof PhotoError&&e.status===status;
async function solid(format:'png'|'jpeg'|'webp'='png',width=100,height=80){return sharp({create:{width,height,channels:3,background:'#258ce6'}})[format]().toBuffer();}

test('normalizes JPEG PNG and static WebP to metadata-free private JPEG and deterministic digest',async()=>{for(const format of ['jpeg','png','webp'] as const){const input=await solid(format),output=await normalizeQuotePhoto(input,`image/${format}`);const metadata=await sharp(output.bytes).metadata();assert.equal(metadata.format,'jpeg');assert.equal(metadata.width,100);assert.equal(metadata.height,80);assert.equal(metadata.exif,undefined);assert.equal(metadata.icc,undefined);assert.equal(metadata.xmp,undefined);assert.equal(hash(output.bytes),output.contentHash);assert.equal((await normalizeQuotePhoto(input,`image/${format}`)).contentHash,output.contentHash);}});
test('applies camera orientation before stripping EXIF/GPS metadata and bounds dimensions',async()=>{const camera=await sharp(await solid('jpeg',40,20)).withMetadata({orientation:6}).withExifMerge({IFD0:{Artist:'Synthetic metadata',Copyright:'Test-only'}}).toBuffer();assert.ok((await sharp(camera).metadata()).exif);const normalized=await normalizeQuotePhoto(camera,'image/jpeg');assert.equal(normalized.width,20);assert.equal(normalized.height,40);assert.equal((await sharp(normalized.bytes).metadata()).exif,undefined);const large=await normalizeQuotePhoto(await solid('png',5000,300),'image/png');assert.equal(large.width,4096);assert.ok(large.bytes.length<=QUOTE_PHOTO_LIMITS.maxStoredBytes);});
test('rejects disguised MIME, SVG/HEIC bytes, corrupt files and animated PNG before normalization',async()=>{await assert.rejects(normalizeQuotePhoto(await solid(),'image/jpeg'),rejects(415));for(const bytes of [Buffer.from('<svg xmlns="http://www.w3.org/2000/svg"/>'),Buffer.from('not a photo'),Buffer.from('0000ftypheic')])await assert.rejects(normalizeQuotePhoto(bytes,'image/png'),rejects(415));await assert.rejects(normalizeQuotePhoto(Buffer.from([137,80,78,71,13,10,26,10]),'image/png'),rejects(422));const png=await solid();const actl=Buffer.alloc(20);actl.writeUInt32BE(8);actl.write('acTL',4);await assert.rejects(normalizeQuotePhoto(Buffer.concat([png.subarray(0,8),actl,png.subarray(8)]),'image/png'),rejects(415));await assert.rejects(normalizeQuotePhoto(new Uint8Array(QUOTE_PHOTO_LIMITS.maxInputBytes+1),'image/png'),rejects(413));});
test('enforces 50-megapixel decoding limit before allocating an oversized image',async()=>{const tooLarge=await solid('png',7100,7100);await assert.rejects(normalizeQuotePhoto(tooLarge,'image/png'),e=>e instanceof PhotoError&&(e.status===413||e.status===422));});
test('validates notice, extensions, byte bounds, unique immutable photo references',()=>{const v={expectedRevision:1,noticeVersion:PHOTO_NOTICE_VERSION,noticeAccepted:true,fileName:'photo.png',mimeType:'image/png',inputBytes:100,sourceHash:hash(new Uint8Array([1])),idempotencyKey:randomUUID()};assert.deepEqual(validatePhotoReservation(v),v);for(const update of [{noticeAccepted:false},{expectedRevision:0},{sourceHash:'forged'},{inputBytes:10485761},{mimeType:'image/svg+xml'},{fileName:'photo.heic'},{fileName:'photo.jpg'}])assert.throws(()=>validatePhotoReservation({...v,...update}),PhotoError);const p={photoId:randomUUID(),contentHash:v.sourceHash,processingVersion:PHOTO_PROCESSING_VERSION};assert.deepEqual(validateQuotePhotoManifest([p]),[p]);for(const value of [[p,p],[{...p,contentHash:'bad'}],[{...p,photoId:'foreign'}],[{...p,processingVersion:'future'}],null])assert.throws(()=>validateQuotePhotoManifest(value),PhotoError);});
test('bounded upload stream rejects actual overflow even without or with dishonest Content-Length',async()=>{for(const headers of [{},{'content-length':'2'}]){let sent=0;const stream=new ReadableStream<Uint8Array>({pull(controller){if(sent++<2)controller.enqueue(new Uint8Array(5));else controller.close();}});const request=new Request('http://localhost/api/quote/photos',{method:'PUT',headers,body:stream,duplex:'half'} as RequestInit);await assert.rejects(receivePhotoBytes(request,8),rejects(413));}assert.deepEqual(await receivePhotoBytes(new Request('http://localhost/api/quote/photos',{method:'PUT',body:new Uint8Array([1,2,3])}),8),new Uint8Array([1,2,3]));});

function portsFixture(){
 const source=new Uint8Array([1,2,3]),normalized=new Uint8Array([4,5,6]);const calls:string[]=[];let object:Uint8Array|null=null;let failAttach=false;let removed=false;
 const p:PhotoRecord={id:randomUUID(),draft_id:randomUUID(),status:'processing',source_hash:hash(source),input_bytes:3,source_mime:'image/png',object_path:'synthetic/id.jpg',content_hash:null,stored_bytes:null,mime_type:null,width:null,height:null,processing_version:PHOTO_PROCESSING_VERSION,lease_holder:'synthetic-worker-holder',lease_generation:1};
 const ports:PhotoPorts={
  async command<T>(command,args){calls.push(command);if(command==='recovery_list')return[p.id] as T;if(command==='claim_upload'||command==='claim_recovery')return{record:{...p},draftRevision:2} as T;if(command==='prepare'){p.content_hash=args.content_hash as string;p.stored_bytes=args.stored_bytes as number;p.width=args.width as number;p.height=args.height as number;}if(command==='attach'){if(failAttach)throw Error('synthetic database outage');p.status='attached';}if(command==='fail')p.status=args.status as PhotoRecord['status'];if(command==='delete_done')p.status='deleted';return{photo:{id:p.id,status:p.status},draftRevision:3} as T;},
  normalize:async()=>({bytes:normalized,contentHash:hash(normalized),width:20,height:10}),upload:async(_,bytes)=>{calls.push('store');object=bytes;},read:async()=>object,remove:async()=>{removed=true;object=null;},hash,workerId:()=>p.lease_holder!,
 };
 return{p,ports,source,normalized,calls,setFailAttach:(value:boolean)=>{failAttach=value;},setObject:(value:Uint8Array|null)=>{object=value;},removed:()=>removed};
}
test('upload reserves validation metadata before storage and only reports saved after DB attachment',async()=>{const f=portsFixture(),app=quotePhotos(f.ports);const result=await app.upload('owner',f.p.id,async()=>f.source);assert.equal(result.photo.status,'attached');assert.deepEqual(f.calls,['claim_upload','prepare','store','attach']);assert.equal(f.p.content_hash,hash(f.normalized));});
test('a storage success followed by database failure recovers the same immutable bytes after restart',async()=>{const f=portsFixture(),app=quotePhotos(f.ports);f.setFailAttach(true);await assert.rejects(app.upload('owner',f.p.id,async()=>f.source));assert.equal(f.p.status,'processing');assert.equal(f.calls.includes('fail'),false);f.setFailAttach(false);assert.deepEqual(await quotePhotos(f.ports).recover(),{recovered:1,deferred:0});assert.equal(f.p.status,'attached');assert.equal(f.calls.filter(x=>x==='store').length,1);});
test('failed or truncated source upload is rejected without uploading or falsely attaching',async()=>{const f=portsFixture();await assert.rejects(quotePhotos(f.ports).upload('owner',f.p.id,async()=>new Uint8Array([9])),rejects(409));assert.equal(f.p.status,'rejected');assert.equal(f.calls.includes('store'),false);});
test('recovery handles missing object as retryable but rejects different bytes and never displays them',async()=>{const f=portsFixture();f.p.content_hash=hash(f.normalized);f.p.stored_bytes=f.normalized.length;await quotePhotos(f.ports).recover();assert.equal(f.p.status,'retryable_error');f.p.status='processing';f.setObject(new Uint8Array([9,9,9]));await quotePhotos(f.ports).recover();assert.equal(f.p.status,'rejected');f.p.status='attached';await assert.rejects(quotePhotos(f.ports).content(f.p),rejects(503));});
test('durable deletion recovery removes only the recorded object and never needs an original file',async()=>{const f=portsFixture();f.p.status='delete_pending';assert.deepEqual(await quotePhotos(f.ports).recover(),{recovered:1,deferred:0});assert.equal(f.removed(),true);assert.equal(f.p.status,'deleted');});
