import test from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {AdminAccessError} from '../admin-access/index.ts'
import {WorkError} from './management.ts'
import {createEnquiryManagementApi,type WorkApiDependencies} from './management-server.ts'
import {createStaffQuoteDraftApi} from '../quotes/staff-drafts-server.ts'
import {createSimpleBookingManagementApi} from '../bookings/simple-management-server.ts'
const actor={companyId:'lk-group',userId:randomUUID(),sessionId:randomUUID()},id=randomUUID(),mutation={expectedRevision:0,idempotencyKey:randomUUID(),reason:'Synthetic management'}
const req=(body:unknown,headers:Record<string,string>={})=>new Request('https://example.invalid/api/admin/test',{method:'POST',headers:{origin:'https://example.invalid','content-type':'application/json',...headers},body:JSON.stringify(body)})
function harness(){const calls:{command:string;args:Record<string,unknown>}[]=[];const deps:WorkApiDependencies={authorize:async()=>actor,baseUrl:()=> 'https://example.invalid',store:{command:async<T>(command:string,args:Record<string,unknown>)=>{calls.push({command,args});return{receipt:{...mutation,entityType:'enquiry',entityId:id,action:command,revision:1,committedAt:new Date().toISOString()}} as T}}};return{calls,deps,enquiry:createEnquiryManagementApi(deps),quote:createStaffQuoteDraftApi(deps),booking:createSimpleBookingManagementApi(deps)}}
test('current actor fields are injected from authorization; unknown body fields and write boundary failures never dispatch',async()=>{const h=harness();assert.equal((await h.enquiry.assign(req({...mutation,assigneeUserId:null}),id)).status,200);assert.equal(h.calls[0].args.actorUserId,actor.userId);for(const body of [{...mutation,assigneeUserId:null,actorUserId:randomUUID()},{...mutation,assigneeUserId:null,expectedRevision:0.5},{...mutation,assigneeUserId:null,idempotencyKey:'bad'}])assert.equal((await h.enquiry.assign(req(body),id)).status,422);for(const [headers,status]of [[{origin:'https://evil.invalid'},403],[{'content-type':'text/plain'},415],[{'content-length':'40000'},413]] as [Record<string,string>,number][])assert.equal((await h.enquiry.assign(req({...mutation,assigneeUserId:null},headers),id)).status,status);assert.equal(h.calls.length,1)})
test('bounded streamed UTF-8 input rejects actual oversized chunks, malformed UTF-8 and malformed JSON',async()=>{const h=harness();for(const [bytes,status]of [[new Uint8Array(32769),413],[new Uint8Array([0xc0,0xaf]),400],[new TextEncoder().encode('{'),400]] as [Uint8Array,number][]){const request=new Request('https://example.invalid/x',{method:'POST',headers:{origin:'https://example.invalid','content-type':'application/json'},body:bytes});assert.equal((await h.enquiry.archive(request,id)).status,status)}assert.equal(h.calls.length,0)})
test('JSON escaped lone surrogates return definite 422 before dispatch across current-work text fields',async()=>{
  const h=harness(),payload={contact:{name:'Synthetic Customer',email:'customer@example.invalid',phone:'',siteAddress:'1 Synthetic Street',suburb:'Sydney',postcode:'2000',details:''},service:null,internalNotes:''},draft={...mutation,takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''}
  for(const text of ['\ud800','\udfff']){
    const responses=[await h.enquiry.archive(req({...mutation,reason:text}),id),await h.enquiry.note(req({...mutation,body:text}),id),await h.quote.save(req({...mutation,payload:{...payload,internalNotes:text}}),id),await h.booking.save(req({...draft,companyNote:text}),id)]
    for(const response of responses){assert.equal(response.status,422);assert.deepEqual(await response.json(),{error:'Enter valid plain text within the field limit.',code:'validation',outcome:'not_applied'})}
  }
  assert.equal(h.calls.length,0)
  assert.equal((await h.enquiry.note(req({...mutation,body:'Ready 😀'}),id)).status,201)
  assert.equal(h.calls[0].args.body,'Ready 😀')
})
test('read filters validate before dispatch and response is private no-store',async()=>{const h=harness(),response=await h.enquiry.list(new Request('https://example.invalid/api/admin/enquiries?status=archived&page=2&pageSize=1'));assert.equal(response.status,200);assert.equal(response.headers.get('cache-control'),'private, no-store');assert.equal(h.calls[0].args.status,'archived');assert.equal(h.calls[0].args.page,2);for(const query of ['status=signed','page=1&page=2','q='+('x'.repeat(121))])assert.equal((await h.enquiry.list(new Request('https://example.invalid/?'+query))).status,422);assert.equal((await h.quote.list(new Request('https://example.invalid/?status=review_requested&staffDraft=saved'))).status,200);assert.equal(h.calls.at(-1)!.args.staffDraft,'saved')})
test('401/403, explicit 409 and uncertain dispatch failures have distinct outcomes',async()=>{for(const status of [401,403]){const h=harness();h.deps.authorize=async()=>{throw new AdminAccessError(status===401?'AUTHENTICATION_REQUIRED':'ACCESS_DENIED')};const response=await h.enquiry.detail(new Request('https://example.invalid'),id);assert.equal(response.status,status);assert.equal((await response.json()).outcome,'not_applied')}const h=harness();h.deps.store.command=async()=>{throw new WorkError(409,'revision_conflict','Changed','not_applied',7)};let response=await h.enquiry.archive(req(mutation),id);assert.equal(response.status,409);assert.equal((await response.json()).currentRevision,7);h.deps.store.command=async()=>{throw Error('network timeout after dispatch')};response=await h.enquiry.archive(req(mutation),id);assert.equal((await response.json()).outcome,'unknown')})
test('nullable Save draft does not resolve Google and paused booking writes return definite 503',async()=>{const h=harness();let enqueued=0;h.deps.enqueue=()=>{enqueued++};const body={...mutation,takeOffEndLocal:null,installStartLocal:null,installEndLocal:null,companyNote:''};assert.equal((await h.booking.save(req(body),id)).status,200);assert.equal(enqueued,0);assert.equal(h.calls[0].command,'booking_save');assert.equal((await h.booking.cancel(req(mutation),id)).status,202);assert.equal(enqueued,1);const api=createSimpleBookingManagementApi({...h.deps,enabled:()=>false});const response=await api.save(req(body),id);assert.equal(response.status,503);assert.equal((await response.json()).outcome,'not_applied')})
test('staff quote accepts only work-copy fields without persisting consent, price or original ownership',async()=>{const h=harness(),payload={contact:{name:'Synthetic Customer',email:'customer@example.invalid',phone:'',siteAddress:'1 Synthetic Street',suburb:'Sydney',postcode:'2000',details:''},service:null,internalNotes:''};assert.equal((await h.quote.save(req({...mutation,payload}),id)).status,200);assert.equal('consent'in (h.calls[0].args.payload as typeof payload).contact,false);assert.equal((await h.quote.save(req({...mutation,payload:{...payload,pricing:{total:1}}}),id)).status,422);assert.equal((await h.quote.save(req({...mutation,payload:{...payload,contact:{...payload.contact,consent:true}}}),id)).status,422)})
