import test,{after,beforeEach} from 'node:test'
import assert from 'node:assert/strict'
import {randomUUID} from 'node:crypto'
import {currentWorkDb,resetCurrentWork,currentWorkRpc,workDbFailure as fail,tableHash} from './infrastructure/management-test-fixtures.mts'
import {seedCompanyFixture} from '../bookings/infrastructure/live-test-fixtures.mts'
import type {EnquiryDetail,WorkReceipt} from './management.ts'
const db=await currentWorkDb();beforeEach(()=>resetCurrentWork(db));after(()=>db.close())
const rpc=<T=EnquiryDetail>(cmd:string,args:Record<string,unknown>)=>currentWorkRpc<T>(db,cmd,args)
async function seed(){const f=await seedCompanyFixture(db);await db.exec('reset role');const id=randomUUID();await db.query("insert into public.lk_enquiries(id,reference,source,payload_json,status,revision,calendar_status) values($1,$2,'gmail',$3,'provisional',1,'pending')",[id,'ENQ-'+id,{name:'Synthetic customer',email:'synthetic@example.invalid',notes:'Original Gmail enquiry',gmail:{raw:'PRIVATE-NOT-EXPOSED'}}]);await db.query("insert into public.lk_gmail_seen(account_sub,message_id,enquiry_id) values('company','message-1',$1)",[id]);await db.exec('set role service_role');return{...f,args:{...f.staffArgs,id,requestId:undefined},id}}
const base=(f:Awaited<ReturnType<typeof seed>>,rev=0)=>({companyId:'lk-group',actorUserId:f.staffId,actorSessionId:f.staffSessionId,id:f.id,expectedRevision:rev,idempotencyKey:randomUUID(),reason:'Synthetic management'})
test('assignment, note add/edit, archive and restore use aggregate CAS and preserve source and Gmail tombstone',async()=>{const f=await seed(),source=await tableHash(db,'lk_enquiries'),gmail=await tableHash(db,'lk_gmail_seen');const read=await rpc('enquiry_detail',base(f));assert.equal(read.management.revision,0);assert.equal(JSON.stringify(read).includes('PRIVATE-NOT-EXPOSED'),false);const a=await rpc<{receipt:WorkReceipt}>('enquiry_assign',{...base(f),assigneeUserId:f.staffId});assert.equal(a.receipt.revision,1);const note=await rpc<{receipt:WorkReceipt}>('enquiry_note_add',{...base(f,1),body:'Internal only'});await rpc('enquiry_note_update',{...base(f,2),noteId:note.receipt.childId,body:'Updated note'});await assert.rejects(rpc('enquiry_assign',{...base(f,2),assigneeUserId:null}),fail('LK409'));await rpc('enquiry_archive',base(f,3));await assert.rejects(rpc('enquiry_note_add',{...base(f,4),body:'Blocked'}),fail('LK409'));await assert.rejects(rpc('enquiry_archive',base(f,4)),fail('LK409'));await rpc('enquiry_restore',base(f,4));const final=await rpc('enquiry_detail',base(f));assert.equal(final.notes[0].body,'Updated note');assert.equal(final.management.revision,5);assert.equal(final.audit.length,5);assert.equal(JSON.stringify(final.audit).includes('Updated note'),false);assert.equal(await tableHash(db,'lk_enquiries'),source);assert.equal(await tableHash(db,'lk_gmail_seen'),gmail)})
test('receipt replay is immutable after later changes and actor/session/payload scoped',async()=>{const f=await seed(),args={...base(f),body:'First'},one=await rpc('enquiry_note_add',args);await rpc('enquiry_assign',{...base(f,1),assigneeUserId:null});assert.deepEqual(await rpc('enquiry_note_add',args),one);await assert.rejects(rpc('enquiry_note_add',{...args,body:'Changed'}),fail('LK409'));const other=await seedCompanyFixture(db);await assert.rejects(rpc('enquiry_note_add',{...args,actorUserId:other.staffId,actorSessionId:other.staffSessionId}),fail('LK409'));await assert.rejects(rpc('enquiry_receipt',{...base(f),idempotencyKey:args.idempotencyKey,actorUserId:other.staffId,actorSessionId:other.staffSessionId}),fail('LK404'));assert.deepEqual(await rpc('enquiry_receipt',{...base(f),idempotencyKey:args.idempotencyKey}),one)})
test('inactive assignee and mismatched note parent fail; archive filter total matches pagination',async()=>{const f=await seed();await db.exec('reset role');const other=randomUUID();await db.query("insert into public.lk_enquiries(id,reference,source,payload_json,status,revision,calendar_status) values($1,$2,'web','{}','submitted',1,'pending')",[other,'ENQ-'+other]);await db.exec('set role service_role');const note=await rpc<{receipt:WorkReceipt}>('enquiry_note_add',{...base(f),body:'Parent protected'});await assert.rejects(rpc('enquiry_note_update',{...base(f),id:other,noteId:note.receipt.childId,body:'Not here'}),fail('LK404'));await assert.rejects(rpc('enquiry_assign',{...base(f,1),assigneeUserId:randomUUID()}),fail('LK422'));await rpc('enquiry_archive',base(f,1));const list=await rpc<{enquiries:unknown[];total:number}>('enquiry_list',{...base(f),page:1,pageSize:1,q:'',status:'active'});assert.equal(list.total,1);assert.equal(list.enquiries.length,1);assert.equal((await rpc<{total:number}>('enquiry_list',{...base(f),page:1,pageSize:1,q:'',status:'archived'})).total,1)})
test('current authorization protects reads/replays/status and direct table mutation and history rewrite',async()=>{const f=await seed(),args={...base(f),assigneeUserId:null};await rpc('enquiry_assign',args);for(const role of ['anon','authenticated']){await db.exec('set role '+role);await assert.rejects(rpc('enquiry_detail',base(f)),fail('42501'))}await db.exec('set role service_role');await assert.rejects(db.exec("update public.lk_enquiry_management set revision=9"),fail('42501'));await db.exec('reset role');await assert.rejects(db.exec("update public.lk_current_work_receipts set action='forged'"),fail('LK409'));await db.query('delete from auth.sessions where id=$1',[f.staffSessionId]);await db.exec('set role service_role');for(const cmd of ['enquiry_detail','enquiry_assign','enquiry_receipt'])await assert.rejects(rpc(cmd,args),fail('LK403'))})
test('audit failure rolls back note, management revision and command receipt atomically',async()=>{const f=await seed();await db.exec('reset role');await db.exec("create function public.r3a_audit_fail() returns trigger language plpgsql as $$begin raise exception 'synthetic audit unavailable';end;$$;create trigger r3a_audit_fail before insert on public.lk_current_work_audit for each row execute function public.r3a_audit_fail();");await db.exec('set role service_role');await assert.rejects(rpc('enquiry_note_add',{...base(f),body:'Must rollback'}));assert.equal((await rpc('enquiry_detail',base(f))).management.revision,0);assert.equal((await rpc('enquiry_detail',base(f))).notes.length,0);assert.equal((await db.query<{n:number}>('select count(*)::integer n from public.lk_current_work_receipts')).rows[0].n,0);await db.exec('reset role');await db.exec('drop trigger r3a_audit_fail on public.lk_current_work_audit;drop function public.r3a_audit_fail();')})
