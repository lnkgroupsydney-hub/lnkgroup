{
  "name": "lk-group",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "integrations:worker": "node --experimental-strip-types scripts/integrations-worker.mjs",
    "test:operations": "node --experimental-strip-types --test src/modules/operations/operations.test.mts src/modules/gmail-intake/infrastructure/gmail-reader.test.ts src/modules/operations/supabase.test.mts src/modules/operations/sync-result.test.mts src/modules/operations/oauth-recovery.test.mts src/modules/enquiries/quote-draft.test.mts src/modules/enquiries/domain/availability.test.mts src/modules/enquiries/demo-submission-db.test.mts src/modules/enquiries/infrastructure/demo-email.test.mts src/modules/enquiries/demo-api.test.mts",
    "test:supabase:connection": "node scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
