# Company Supabase storage. Run npm run setup:local for private local auth settings.
OPERATIONS_STORE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://xlqyafthsxallostcqfe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix this with NEXT_PUBLIC_ or commit it.
SUPABASE_SECRET_KEY=
# The current owner login remains loopback-only; cloud hosting is a later step.
LOCAL_OPERATIONS_ENABLED=false
APP_BASE_URL=http://127.0.0.1:3002
LOCAL_OWNER_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser key for Maps JavaScript API + Places API (New), separate from OAuth.
# Restrict by website referrer and these two APIs in the company Cloud project.
# NEXT_PUBLIC_ values are embedded at build time; rebuild after changing the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Preserve the same encryption key across app/worker/restarts.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Isolated offline testing only: explicitly set OPERATIONS_STORE=sqlite.
LOCAL_OPERATIONS_DB_PATH=
# Local demo only: sample price/terms, company-only trial email, no real contract.
QUOTE_DEMO_ENABLED=false
QUOTE_DEMO_RECIPIENT_EMAIL=lnkgroupsydney@gmail.com
RESEND_FROM_EMAIL=L&K Demo <onboarding@resend.dev>
RESEND_API_KEY=

# Initial staff Auth flow; requires private session RPC and an authorized Auth account.
# Keep false until onboarding is configured. This disables legacy owner login when true.
STAFF_ADMIN_AUTH_ENABLED=false
# Explicit email verification is separate from Supabase aal2 MFA. Initial company admin only.
STAFF_ADMIN_SECOND_STEP=email
# Server-only random 32-byte hexadecimal HMAC key; never use a NEXT_PUBLIC_ variable.
STAFF_EMAIL_OTP_SECRET=
